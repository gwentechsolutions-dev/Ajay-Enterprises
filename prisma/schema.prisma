  @@index([documentType, documentId])
  @@index([deliveryNoteId])
  @@index([returnNoteId])
  @@index([transferNoteId])
}

// ------------------------------------------------------------------------------
// 17. E-Way Bill Integration (FYN Gateway)
// ------------------------------------------------------------------------------

model EWayBill {
  id              String             @id @default(uuid()) @db.Uuid
  ewbNumber       String             @unique // Official 12-digit E-Way Bill number
  documentType    String             // DELIVERY_NOTE, TRANSFER_NOTE
  documentId      String             @db.Uuid
  deliveryNoteId  String?            @db.Uuid
  transferNoteId  String?            @db.Uuid
  generatedAt     DateTime           @default(now())
  validUntil      DateTime?
  vehicleNumber   String?
  fromPincode     String?
  toPincode       String?
  distanceKm      Int?
  status          String             @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED
  fynReferenceId  String?
  cancelReason    String?
  cancelledAt     DateTime?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  deliveryNote    DeliveryNote?      @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  transferNote    StockTransferNote? @relation(fields: [transferNoteId], references: [id], onDelete: Cascade)

  @@index([ewbNumber])
  @@index([documentType, documentId])
  @@index([deliveryNoteId])
  @@index([transferNoteId])
  @@index([status])
}

// ==============================================================================
// PHASE 4: RENTAL MANAGEMENT & MONTHLY BILLING ENGINE
// ==============================================================================

// ------------------------------------------------------------------------------
// 18. Rental Agreement
// ------------------------------------------------------------------------------

model RentalAgreement {
  id                   String                     @id @default(uuid()) @db.Uuid
  agreementNumber      String                     @unique // e.g. "AE/AGR/2026-27/0001"
  customerId           String                     @db.Uuid
  customerSiteId       String                     @db.Uuid
  startDate            DateTime
  endDate              DateTime?
  billingFrequency     String                     @default("MONTHLY") // MONTHLY, CUSTOM
  billingCycleDay      Int                        @default(1)
  depositAmount        Decimal                    @default(0) @db.Decimal(15, 2)
  depositStatus        String                     @default("PENDING") // PENDING, PARTIALLY_PAID, FULLY_PAID, REFUNDED
  paymentTerms         String?
  specialTerms         String?
  status               String                     @default("DRAFT") // DRAFT, ACTIVE, SUSPENDED, COMPLETED, CANCELLED
  createdById          String?                    @db.Uuid
  approvedById         String?                    @db.Uuid
  approvedAt           DateTime?
  attachments          Json?
  notes                String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  customer             Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite         CustomerSite               @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  items                RentalAgreementItem[]
  deposits             RentalDepositTransaction[]
  statements           RentalStatement[]
  sourceTransfers      DirectSiteTransferNote[] @relation("SourceTransferAgreement")
  destinationTransfers DirectSiteTransferNote[] @relation("DestTransferAgreement")

  @@index([agreementNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([status])
  @@index([startDate])
}

model RentalAgreementItem {
  id                  String          @id @default(uuid()) @db.Uuid
  rentalAgreementId   String          @db.Uuid
  materialVariantId   String          @db.Uuid
  agreedDailyRate     Decimal         @db.Decimal(15, 2)
  securityDepositRate Decimal?        @db.Decimal(15, 2)
  remarks             String?

  rentalAgreement     RentalAgreement @relation(fields: [rentalAgreementId], references: [id], onDelete: Cascade)
  materialVariant     MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([rentalAgreementId])
  @@index([materialVariantId])
}

// ------------------------------------------------------------------------------
// 19. Material Rental Tracking Batches
// ------------------------------------------------------------------------------

model RentalBatch {
  id                   String                   @id @default(uuid()) @db.Uuid
  batchNumber          String                   @unique // e.g. "RB-2026-0001"
  customerId           String                   @db.Uuid
  customerSiteId       String                   @db.Uuid
  materialVariantId    String                   @db.Uuid
  ownershipType        String                   @default("OWNED") // OWNED, HIRED_IN
  deliveryNoteId       String?                  @db.Uuid
  deliveryNoteItemId   String?                  @db.Uuid
  directSiteTransferId     String?              @db.Uuid
  directSiteTransferItemId String?              @db.Uuid
  deliveryDate         DateTime
  includeDeliveryDate  Boolean                  @default(true)
  deliveredQty         Decimal                  @db.Decimal(12, 3)
  returnedQty          Decimal                  @default(0) @db.Decimal(12, 3)
  damagedQty           Decimal                  @default(0) @db.Decimal(12, 3)
  missingQty           Decimal                  @default(0) @db.Decimal(12, 3)
  currentHeldQty       Decimal                  @db.Decimal(12, 3)
  applicableDailyRate  Decimal                  @db.Decimal(15, 2)
  status               String                   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  customer             Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite         CustomerSite             @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  materialVariant      MaterialVariant          @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  deliveryNote         DeliveryNote?            @relation(fields: [deliveryNoteId], references: [id], onDelete: SetNull)
  deliveryNoteItem     DeliveryNoteItem?        @relation(fields: [deliveryNoteItemId], references: [id], onDelete: SetNull)
  directSiteTransfer     DirectSiteTransferNote? @relation("DestBatchTransfer", fields: [directSiteTransferId], references: [id], onDelete: SetNull)
  directSiteTransferItem DirectSiteTransferItem? @relation("DestBatchTransferItem", fields: [directSiteTransferItemId], references: [id], onDelete: SetNull)
  returnAllocations    RentalReturnAllocation[]
  statementItems       RentalStatementItem[]
  dayDetails           RentalStatementDayDetail[]
  materialRepairJobs   MaterialRepairJob[]
  sourceTransferItems  DirectSiteTransferItem[] @relation("SourceBatchTransferItem")

  @@index([customerId])
  @@index([customerSiteId])
  @@index([materialVariantId])
  @@index([deliveryNoteId])
  @@index([directSiteTransferId])
  @@index([ownershipType])
  @@index([status])
  @@index([deliveryDate])
}

model RentalReturnAllocation {
  id                       String                  @id @default(uuid()) @db.Uuid
  rentalBatchId            String                  @db.Uuid
  materialReturnNoteId     String?                 @db.Uuid
  materialReturnNoteItemId String?                 @db.Uuid
  directSiteTransferId     String?                 @db.Uuid
  directSiteTransferItemId String?                 @db.Uuid
  returnDate               DateTime
  includeReturnDate        Boolean                 @default(false)
  allocatedReturnedQty     Decimal                 @db.Decimal(12, 3)
  allocatedAcceptedQty     Decimal                 @db.Decimal(12, 3)
  allocatedDamagedQty      Decimal                 @default(0) @db.Decimal(12, 3)
  allocatedMissingQty      Decimal                 @default(0) @db.Decimal(12, 3)
  createdAt                DateTime                @default(now())

  rentalBatch              RentalBatch             @relation(fields: [rentalBatchId], references: [id], onDelete: Cascade)
  materialReturnNote       MaterialReturnNote?     @relation(fields: [materialReturnNoteId], references: [id], onDelete: SetNull)
  materialReturnNoteItem   MaterialReturnNoteItem? @relation(fields: [materialReturnNoteItemId], references: [id], onDelete: SetNull)
  directSiteTransfer       DirectSiteTransferNote? @relation("TransferReturnAllocations", fields: [directSiteTransferId], references: [id], onDelete: SetNull)
  directSiteTransferItem   DirectSiteTransferItem? @relation(fields: [directSiteTransferItemId], references: [id], onDelete: SetNull)

  @@index([rentalBatchId])
  @@index([materialReturnNoteId])
  @@index([materialReturnNoteItemId])
  @@index([directSiteTransferId])
  @@index([returnDate])
}

// ------------------------------------------------------------------------------
// 19B. Direct Site-to-Site Material Transfers
// ------------------------------------------------------------------------------

model DirectSiteTransferNote {
  id                           String                    @id @default(uuid()) @db.Uuid
  transferNumber               String                    @unique // e.g. "AE/DSTN/2026-27/0001"
  transferDate                 DateTime                  @default(now())
  sourceCustomerId             String                    @db.Uuid
  sourceCustomerSiteId         String                    @db.Uuid
  destinationCustomerId        String                    @db.Uuid
  destinationCustomerSiteId    String                    @db.Uuid
  sourceRentalAgreementId      String?                   @db.Uuid
  destinationRentalAgreementId String?                   @db.Uuid
  vehicleId                    String?                   @db.Uuid
  driverId                     String?                   @db.Uuid
  vehicleTripId                String?                   @db.Uuid
  status                       String                    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, DISPATCHED, PARTIALLY_RECEIVED, COMPLETED, REJECTED, CANCELLED

  // Dispatch fields
  dispatchedAt                 DateTime?
  dispatchedById               String?                   @db.Uuid
  sourceRepName                String?
  sourceRepPhone               String?
  sourceRepDesignation         String?
  sourceRepSignatureUrl        String?
  sourceGpsLat                 Decimal?                  @db.Decimal(10, 7)
  sourceGpsLng                 Decimal?                  @db.Decimal(10, 7)
  sourcePhotoUrl               String?

  // Receipt fields
  receivedAt                   DateTime?
  receivedById                 String?                   @db.Uuid
  destRepName                  String?
  destRepPhone                 String?
  destRepDesignation           String?
  destRepSignatureUrl          String?
  destGpsLat                   Decimal?                  @db.Decimal(10, 7)
  destGpsLng                   Decimal?                  @db.Decimal(10, 7)
  destPhotoUrl                 String?

  includeCutoffDate            Boolean                   @default(false)
  transportCharges             Decimal                   @default(0) @db.Decimal(15, 2)
  notes                        String?
  discrepancyNotes             String?
  discrepancyResponsibleParty  String?                   @default("UNDER_INVESTIGATION") // SOURCE_CUSTOMER, TRANSPORTER, DESTINATION_CUSTOMER, UNDER_INVESTIGATION
  rejectedDisposition          String?                   @default("RETURN_TO_WAREHOUSE") // RETURN_TO_WAREHOUSE, HELD_IN_TRANSIT, RETURNED_TO_SOURCE
  createdById                  String?                   @db.Uuid
  approvedById                 String?                   @db.Uuid
  approvedAt                   DateTime?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  sourceCustomer               Customer                  @relation("SourceTransferCustomer", fields: [sourceCustomerId], references: [id], onDelete: Restrict)
  sourceCustomerSite           CustomerSite              @relation("SourceTransferSite", fields: [sourceCustomerSiteId], references: [id], onDelete: Restrict)
  destinationCustomer          Customer                  @relation("DestTransferCustomer", fields: [destinationCustomerId], references: [id], onDelete: Restrict)
  destinationCustomerSite     CustomerSite              @relation("DestTransferSite", fields: [destinationCustomerSiteId], references: [id], onDelete: Restrict)
  sourceRentalAgreement        RentalAgreement?          @relation("SourceTransferAgreement", fields: [sourceRentalAgreementId], references: [id], onDelete: SetNull)
  destinationRentalAgreement   RentalAgreement?          @relation("DestTransferAgreement", fields: [destinationRentalAgreementId], references: [id], onDelete: SetNull)
  vehicle                      Vehicle?                  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver                       Driver?                   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleTrip                  VehicleTrip?              @relation(fields: [vehicleTripId], references: [id], onDelete: SetNull)

  items                        DirectSiteTransferItem[]
  rentalBatches                RentalBatch[]             @relation("DestBatchTransfer")
  returnAllocations            RentalReturnAllocation[]  @relation("TransferReturnAllocations")
  damageAssessments            DamageLossAssessment[]
  materialRepairJobs           MaterialRepairJob[]

  @@index([sourceCustomerId])
  @@index([sourceCustomerSiteId])
  @@index([destinationCustomerId])
  @@index([destinationCustomerSiteId])
  @@index([status])
  @@index([transferDate])
}

model DirectSiteTransferItem {
  id                       String                  @id @default(uuid()) @db.Uuid
  transferId               String                  @db.Uuid
  materialVariantId        String                  @db.Uuid
  ownershipType            String                  @default("OWNED") // OWNED, HIRED_IN
  sourceRentalBatchId      String?                 @db.Uuid
  quantityDispatched       Decimal                 @db.Decimal(12, 3)
  quantityAccepted         Decimal                 @default(0) @db.Decimal(12, 3)
  quantityDamaged          Decimal                 @default(0) @db.Decimal(12, 3)
  quantityMissing          Decimal                 @default(0) @db.Decimal(12, 3)
  quantityRejected         Decimal                 @default(0) @db.Decimal(12, 3)
  agreedDailyRate          Decimal?                @db.Decimal(15, 2)
  remarks                  String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  transfer                 DirectSiteTransferNote  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  materialVariant          MaterialVariant         @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  sourceRentalBatch        RentalBatch?            @relation("SourceBatchTransferItem", fields: [sourceRentalBatchId], references: [id], onDelete: SetNull)
  destinationBatches       RentalBatch[]           @relation("DestBatchTransferItem")
  returnAllocations        RentalReturnAllocation[]

  @@index([transferId])
  @@index([materialVariantId])
  @@index([sourceRentalBatchId])
  @@index([ownershipType])
}

// ------------------------------------------------------------------------------
// 20. Monthly Rental Statements & Consolidated Billing
// ------------------------------------------------------------------------------

model RentalStatement {
  id                           String                       @id @default(uuid()) @db.Uuid
  statementNumber              String                       @unique // e.g. "AE/STM/2026-27/0001"
  billingMode                  String                       @default("SITE_WISE") // SITE_WISE, CONSOLIDATED
  customerId                   String                       @db.Uuid
  customerSiteId               String?                      @db.Uuid // Nullable for CONSOLIDATED mode
  rentalAgreementId            String?                      @db.Uuid
  periodStartDate              DateTime
  periodEndDate                DateTime
  totalRentalAmount            Decimal                      @default(0) @db.Decimal(15, 2)
  totalDamageCharges           Decimal                      @default(0) @db.Decimal(15, 2)
  totalMissingCharges          Decimal                      @default(0) @db.Decimal(15, 2)
  totalAdjustments             Decimal                      @default(0) @db.Decimal(15, 2)
  netPayableAmount             Decimal                      @default(0) @db.Decimal(15, 2)
  previousBalanceInformational Decimal                      @default(0) @db.Decimal(15, 2)
  status                       String                       @default("DRAFT") // DRAFT, CALCULATED, REVIEWED, APPROVED, FINALIZED, CANCELLED
  calculatedAt                 DateTime?
  approvedById                 String?                      @db.Uuid
  approvedAt                   DateTime?
  finalizedById                String?                      @db.Uuid
  finalizedAt                  DateTime?
  snapshotPayload              Json?                        // Immutability: frozen payload on finalization
  remarks                      String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  customer                     Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite                 CustomerSite?                @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  rentalAgreement              RentalAgreement?             @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)
  items                        RentalStatementItem[]
  siteSummaries                RentalStatementSiteSummary[]
  damageAssessments            DamageLossAssessment[]
  invoices                     Invoice[]

  @@index([statementNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([periodStartDate, periodEndDate])
  @@index([status])
}

model RentalStatementItem {
  id                  String                     @id @default(uuid()) @db.Uuid
  statementId         String                     @db.Uuid
  customerSiteId      String                     @db.Uuid
  materialVariantId   String                     @db.Uuid
  rentalBatchId       String?                    @db.Uuid
  ownershipType       String                     @default("OWNED")
  openingHeldQty      Decimal                    @db.Decimal(12, 3)
  newDeliveredQty     Decimal                    @default(0) @db.Decimal(12, 3)
  returnedQty         Decimal                    @default(0) @db.Decimal(12, 3)
  damagedQty          Decimal                    @default(0) @db.Decimal(12, 3)
  missingQty          Decimal                    @default(0) @db.Decimal(12, 3)
  closingHeldQty      Decimal                    @db.Decimal(12, 3)
  billableDays        Int
  applicableDailyRate Decimal                    @db.Decimal(15, 2)
  rentalAmount        Decimal                    @db.Decimal(15, 2)
  remarks             String?

  statement           RentalStatement            @relation(fields: [statementId], references: [id], onDelete: Cascade)
  customerSite        CustomerSite               @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  materialVariant     MaterialVariant            @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  rentalBatch         RentalBatch?               @relation(fields: [rentalBatchId], references: [id], onDelete: SetNull)
  dayDetails          RentalStatementDayDetail[]

  @@index([statementId])
  @@index([customerSiteId])
  @@index([materialVariantId])
  @@index([rentalBatchId])
}

model RentalStatementDayDetail {
  id                String              @id @default(uuid()) @db.Uuid
  statementItemId   String              @db.Uuid
  rentalBatchId     String?             @db.Uuid
  calculationDate   DateTime
  eligibleQuantity  Decimal             @db.Decimal(12, 3)
  dailyRate         Decimal             @db.Decimal(15, 2)
  dayAmount         Decimal             @db.Decimal(15, 2)
  isDeliveryDay     Boolean             @default(false)
  isReturnDay       Boolean             @default(false)
  billed            Boolean             @default(true)
  explanation       String?

  statementItem     RentalStatementItem @relation(fields: [statementItemId], references: [id], onDelete: Cascade)
  rentalBatch       RentalBatch?        @relation(fields: [rentalBatchId], references: [id], onDelete: SetNull)

  @@index([statementItemId])
  @@index([rentalBatchId])
  @@index([calculationDate])
}

model RentalStatementSiteSummary {
  id                 String          @id @default(uuid()) @db.Uuid
  statementId        String          @db.Uuid
  customerSiteId     String          @db.Uuid
  siteRentalAmount   Decimal         @db.Decimal(15, 2)
  siteDamageCharges  Decimal         @default(0) @db.Decimal(15, 2)
  siteMissingCharges Decimal         @default(0) @db.Decimal(15, 2)
  siteTotalAmount    Decimal         @db.Decimal(15, 2)

  statement          RentalStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  customerSite       CustomerSite    @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@index([customerSiteId])
}

// ------------------------------------------------------------------------------
// 21. Damage and Missing Material Assessments
// ------------------------------------------------------------------------------

model DamageLossAssessment {
  id                   String              @id @default(uuid()) @db.Uuid
  assessmentNumber     String              @unique // e.g. "AE/DLA/2026-27/0001"
  customerId           String              @db.Uuid
  customerSiteId       String              @db.Uuid
  materialReturnNoteId String?             @db.Uuid
  materialVariantId    String              @db.Uuid
  statementId          String?             @db.Uuid
  directSiteTransferId String?             @db.Uuid
  assessmentType       String              // DAMAGED_REPAIRABLE, DAMAGED_SCRAP, MISSING
  quantity             Decimal             @db.Decimal(12, 3)
  condition            String              @default("DAMAGED")
  assessmentDate       DateTime            @default(now())
  approvedChargeAmount Decimal             @default(0) @db.Decimal(15, 2)
  status               String              @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, DISPUTED, SETTLED
  remarks              String?
  photographs          Json?
  assessedById         String?             @db.Uuid
  approvedById         String?             @db.Uuid
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite         CustomerSite        @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  materialReturnNote   MaterialReturnNote? @relation(fields: [materialReturnNoteId], references: [id], onDelete: SetNull)
  materialVariant      MaterialVariant     @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  statement            RentalStatement?    @relation(fields: [statementId], references: [id], onDelete: SetNull)
  directSiteTransfer   DirectSiteTransferNote? @relation(fields: [directSiteTransferId], references: [id], onDelete: SetNull)

  @@index([assessmentNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([materialReturnNoteId])
  @@index([materialVariantId])
  @@index([statementId])
  @@index([directSiteTransferId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 22. Rental Deposit Transactions
// ------------------------------------------------------------------------------

model RentalDepositTransaction {
  id                 String           @id @default(uuid()) @db.Uuid
  depositNumber      String           @unique // e.g. "AE/DEP/2026-27/0001"
  rentalAgreementId  String?          @db.Uuid
  customerId         String           @db.Uuid
  customerSiteId     String           @db.Uuid
  transactionType    String           // DEPOSIT_RECEIVED, DEPOSIT_ADJUSTMENT, DEPOSIT_REFUND
  amount             Decimal          @db.Decimal(15, 2)
  receiptDate        DateTime         @default(now())
  referenceNumber    String?
  notes              String?
  refundEligibility  Boolean          @default(false)
  refundStatus       String?          // PENDING, APPROVED, PROCESSED, REJECTED
  refundAmount       Decimal?         @db.Decimal(15, 2)
  approvedById       String?          @db.Uuid
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite       CustomerSite     @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  rentalAgreement    RentalAgreement? @relation(fields: [rentalAgreementId], references: [id], onDelete: SetNull)

  @@index([depositNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([rentalAgreementId])
  @@index([transactionType])
}

// ------------------------------------------------------------------------------
// 23. Customer Site Closure & Final Settlement
// ------------------------------------------------------------------------------

model SiteClosureSettlement {
  id                        String       @id @default(uuid()) @db.Uuid
  settlementNumber          String       @unique // e.g. "AE/SET/2026-27/0001"
  customerId                String       @db.Uuid
  customerSiteId            String       @db.Uuid
  closureDate               DateTime     @default(now())
  status                    String       @default("DRAFT") // DRAFT, UNDER_REVIEW, EXCEPTION_APPROVED, COMPLETED, CANCELLED
  outstandingHeldQty        Decimal      @default(0) @db.Decimal(12, 3)
  unreturnedMaterialDetails Json?
  damageChargesTotal        Decimal      @default(0) @db.Decimal(15, 2)
  missingChargesTotal       Decimal      @default(0) @db.Decimal(15, 2)
  finalRentalTotal          Decimal      @default(0) @db.Decimal(15, 2)
  depositBalance            Decimal      @default(0) @db.Decimal(15, 2)
  netPayableOrRefundable    Decimal      @default(0) @db.Decimal(15, 2)
  hasOutstandingStock       Boolean      @default(false)
  ownerApprovedException    Boolean      @default(false)
  exceptionApprovedById     String?      @db.Uuid
  exceptionReason           String?
  customerAcknowledgement   Json?
  remarks                   String?
  createdById               String?      @db.Uuid
  finalizedById             String?      @db.Uuid
  finalizedAt               DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  customer                  Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite              CustomerSite @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)

  @@index([settlementNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([status])
}


// ==============================================================================
// PHASE 5: INVOICING, GST & DOUBLE-ENTRY ACCOUNTING ERP
// ==============================================================================

// ------------------------------------------------------------------------------
// 24. Double-Entry Chart of Accounts
// ------------------------------------------------------------------------------

model ChartOfAccount {
  id                   String           @id @default(uuid()) @db.Uuid
  accountCode          String           @unique // e.g. "1000", "1110", "2000", "3000", "4000", "5000"
  accountName          String           // e.g. "Rental Income", "Accounts Receivable", "HDFC Current A/c"
  accountCategory      String           // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  accountSubcategory   String           // CASH_IN_HAND, BANK_ACCOUNT, UPI_CLEARING, ACCOUNTS_RECEIVABLE, ACCOUNTS_PAYABLE, CUSTOMER_ADVANCES, SUPPLIER_ADVANCES, SECURITY_DEPOSIT_LIABILITY, RENTAL_INCOME, SALES_INCOME, HIRING_INCOME, SERVICE_INCOME, PURCHASE_EXPENSE, MATERIAL_REPAIR, LABOUR_EXPENSE, VEHICLE_EXPENSE, OFFICE_EXPENSE, GST_INPUT_TAX_CREDIT, GST_OUTPUT_LIABILITY, TDS_PAYABLE, TDS_RECEIVABLE, DEPRECIATION, BAD_DEBTS, OTHER_INCOME, OTHER_EXPENSE
  parentAccountId      String?          @db.Uuid
  currency             String           @default("INR")
  openingBalance       Decimal          @default(0) @db.Decimal(15, 2)
  openingBalanceType   String           @default("DEBIT") // DEBIT, CREDIT
  currentBalance       Decimal          @default(0) @db.Decimal(15, 2)
  isControlAccount     Boolean          @default(false)
  isSystemProtected    Boolean          @default(false) // cannot be deleted
  isActive             Boolean          @default(true)
  bankAccountId        String?          @db.Uuid
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  parentAccount        ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts        ChartOfAccount[] @relation("AccountHierarchy")
  journalLines         JournalEntryLine[]
  receipts             PaymentReceipt[]
  payments             SupplierPayment[]
  bankTransactions     BankTransaction[]
  openingBalanceItems  OpeningBalanceItem[]

  @@index([accountCode])
  @@index([accountCategory])
  @@index([accountSubcategory])
  @@index([parentAccountId])
}

// ------------------------------------------------------------------------------
// 25. Accounting Periods & FY Locking
// ------------------------------------------------------------------------------

model AccountingPeriod {
  id              String         @id @default(uuid()) @db.Uuid
  fiscalYear      String         // e.g. "2026-27"
  periodName      String         // e.g. "May 2026"
  startDate       DateTime
  endDate         DateTime
  isLocked        Boolean        @default(false)
  lockedById      String?        @db.Uuid
  lockedAt        DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  journalEntries  JournalEntry[]

  @@unique([fiscalYear, periodName])
  @@index([fiscalYear])
  @@index([startDate, endDate])
  @@index([isLocked])
}

// ------------------------------------------------------------------------------
// 26. General Ledger Journal Entries
// ------------------------------------------------------------------------------

model JournalEntry {
  id                    String             @id @default(uuid()) @db.Uuid
  journalNumber         String             @unique // e.g. "AE/JRN/2026-27/0001"
  journalType           String             @default("GENERAL") // GENERAL, SALES, PURCHASE, RECEIPT, PAYMENT, CONTRA, ADJUSTMENT, REVERSAL, YEAR_END_CLOSING
  postingDate           DateTime           @default(now())
  accountingPeriodId    String?            @db.Uuid
  fiscalYear            String             // e.g. "2026-27"
  narration             String
  referenceDocumentType String?            // INVOICE, PURCHASE_BILL, PAYMENT_RECEIPT, SUPPLIER_PAYMENT, RENTAL_STATEMENT, SITE_CLOSURE
  referenceDocumentId   String?
  referenceNumber       String?
  totalDebit            Decimal            @db.Decimal(15, 2)
  totalCredit           Decimal            @db.Decimal(15, 2)
  isBalanced            Boolean            @default(true)
  status                String             @default("POSTED") // DRAFT, POSTED, REVERSED
  postedById            String?            @db.Uuid
  postedAt              DateTime?          @default(now())
  reversedById          String?            @db.Uuid
  reversedAt            DateTime?
  reversalJournalId     String?            @db.Uuid
  reversalReason        String?
  supportingDocUrl      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  accountingPeriod      AccountingPeriod?  @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  lines                 JournalEntryLine[]
  invoices              Invoice[]
  creditDebitNotes      CreditDebitNote[]
  purchaseBills         PurchaseBill[]
  receipts              PaymentReceipt[]
  payments              SupplierPayment[]
  vehicleFuelLogs            VehicleFuelLog[]
  vehicleMaintenanceRecords  VehicleMaintenanceRecord[]
  vehicleExpenses            VehicleExpense[]
  labourAdvances             LabourAdvance[]
  labourWageSettlements      LabourWageSettlement[]
  labourPayments             LabourPayment[]
  materialRepairJobs         MaterialRepairJob[]
  openingBalanceBatches      OpeningBalanceBatch[]

  @@index([journalNumber])
  @@index([journalType])
  @@index([postingDate])
  @@index([fiscalYear])
  @@index([status])
  @@index([referenceDocumentType, referenceDocumentId])
}

model JournalEntryLine {
  id              String          @id @default(uuid()) @db.Uuid
  journalEntryId  String          @db.Uuid
  accountId       String          @db.Uuid
  lineOrder       Int             @default(1)
  description     String?
  debitAmount     Decimal         @default(0) @db.Decimal(15, 2)
  creditAmount    Decimal         @default(0) @db.Decimal(15, 2)
  customerId      String?         @db.Uuid
  customerSiteId  String?         @db.Uuid
  supplierId      String?         @db.Uuid
  createdAt       DateTime        @default(now())

  journalEntry    JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         ChartOfAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSite    CustomerSite?   @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([supplierId])
}

// ------------------------------------------------------------------------------
// 27. Sales & Rental Invoicing
// ------------------------------------------------------------------------------

model Invoice {
  id                   String              @id @default(uuid()) @db.Uuid
  invoiceNumber        String              @unique // e.g. "AE/INV/2026-27/0001"
  invoiceType          String              // RENTAL, SALES, SERVICE, HIRING_OUT
  customerId           String              @db.Uuid
  customerSiteId       String?             @db.Uuid // Nullable for consolidated invoices
  rentalStatementId    String?             @db.Uuid // Linked to Phase 4 statement
  invoiceDate          DateTime            @default(now())
  dueDate              DateTime
  fiscalYear           String              // "2026-27"
  placeOfSupply        String              @default("33") // State Code (33 for Tamil Nadu)
  isInterState         Boolean             @default(false)
  customerGstin        String?
  customerPan          String?
  billingAddress       Json?
  shippingAddress      Json?
  subtotal             Decimal             @default(0) @db.Decimal(15, 2)
  taxableAmount        Decimal             @default(0) @db.Decimal(15, 2)
  cgstAmount           Decimal             @default(0) @db.Decimal(15, 2)
  sgstAmount           Decimal             @default(0) @db.Decimal(15, 2)
  igstAmount           Decimal             @default(0) @db.Decimal(15, 2)
  totalTaxAmount       Decimal             @default(0) @db.Decimal(15, 2)
  roundOff             Decimal             @default(0) @db.Decimal(15, 2)
  grandTotal           Decimal             @default(0) @db.Decimal(15, 2)
  paidAmount           Decimal             @default(0) @db.Decimal(15, 2)
  outstandingAmount    Decimal             @default(0) @db.Decimal(15, 2)
  paymentStatus        String              @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  status               String              @default("DRAFT") // DRAFT, ISSUED, POSTED, CANCELLED
  journalEntryId       String?             @db.Uuid
  irn                  String?             // E-Invoice IRN
  signedQrCode         String?             // E-Invoice Signed QR
  ackNumber            String?
  ackDate              DateTime?
  eInvoiceStatus       String              @default("NOT_APPLICABLE") // NOT_APPLICABLE, PENDING, GENERATED, FAILED, CANCELLED
  snapshotPayload      Json?               // Immutability: frozen payload on post
  notes                String?
  termsAndConditions   String?
  createdById          String?             @db.Uuid
  postedById           String?             @db.Uuid
  postedAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite         CustomerSite?       @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)
  rentalStatement      RentalStatement?    @relation(fields: [rentalStatementId], references: [id], onDelete: SetNull)
  journalEntry         JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  items                InvoiceItem[]
  creditDebitNotes     CreditDebitNote[]
  paymentAllocations   PaymentAllocation[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([rentalStatementId])
  @@index([invoiceDate])
  @@index([fiscalYear])
  @@index([status])
  @@index([paymentStatus])
}

model InvoiceItem {
  id                 String           @id @default(uuid()) @db.Uuid
  invoiceId          String           @db.Uuid
  materialVariantId  String?          @db.Uuid
  itemType           String           @default("RENTAL") // RENTAL, SALES, SERVICE, DAMAGE_CHARGE, MISSING_CHARGE, TRANSPORT, OTHER
  itemDescription    String
  hsnSacCode         String           @default("9973") // 9973 rental, 7308 goods
  quantity           Decimal          @default(1) @db.Decimal(12, 3)
  uom                String           @default("Nos.")
  unitRate           Decimal          @default(0) @db.Decimal(15, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(15, 2)
  taxableValue       Decimal          @default(0) @db.Decimal(15, 2)
  gstRatePercent     Decimal          @default(18) @db.Decimal(5, 2)
  cgstRatePercent    Decimal          @default(9) @db.Decimal(5, 2)
  cgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  sgstRatePercent    Decimal          @default(9) @db.Decimal(5, 2)
  sgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  igstRatePercent    Decimal          @default(0) @db.Decimal(5, 2)
  igstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(15, 2)
  createdAt          DateTime         @default(now())

  invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  materialVariant    MaterialVariant? @relation(fields: [materialVariantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([materialVariantId])
  @@index([hsnSacCode])
}

// ------------------------------------------------------------------------------
// 28. Credit & Debit Notes
// ------------------------------------------------------------------------------

model CreditDebitNote {
  id                 String                 @id @default(uuid()) @db.Uuid
  noteNumber         String                 @unique // e.g. "AE/CN/2026-27/0001" or "AE/DN-ADJ/2026-27/0001"
  noteType           String                 // CREDIT_NOTE, DEBIT_NOTE
  invoiceId          String                 @db.Uuid
  customerId         String                 @db.Uuid
  noteDate           DateTime               @default(now())
  fiscalYear         String
  reason             String                 // RATE_DIFFERENCE, DISCOUNT, QUANTITY_ADJUSTMENT, DAMAGE_WAIVER, RETURN, OTHER
  taxableAmount      Decimal                @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal                @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal                @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal                @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal                @default(0) @db.Decimal(15, 2)
  status             String                 @default("POSTED") // DRAFT, ISSUED, POSTED, CANCELLED
  journalEntryId     String?                @db.Uuid
  snapshotPayload    Json?
  remarks            String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  invoice            Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  items              CreditDebitNoteItem[]

  @@index([noteNumber])
  @@index([noteType])
  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

model CreditDebitNoteItem {
  id                 String           @id @default(uuid()) @db.Uuid
  creditDebitNoteId  String           @db.Uuid
  description        String
  hsnSacCode         String           @default("9973")
  taxableValue       Decimal          @default(0) @db.Decimal(15, 2)
  gstRatePercent     Decimal          @default(18) @db.Decimal(5, 2)
  cgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(15, 2)

  creditDebitNote    CreditDebitNote  @relation(fields: [creditDebitNoteId], references: [id], onDelete: Cascade)

  @@index([creditDebitNoteId])
}

// ------------------------------------------------------------------------------
// 29. Purchase Bills & Supplier Invoicing
// ------------------------------------------------------------------------------

model PurchaseBill {
  id                    String                     @id @default(uuid()) @db.Uuid
  billNumber            String                     @unique // e.g. "AE/PUR/2026-27/0001"
  billType              String                     @default("MATERIAL_PURCHASE") // MATERIAL_PURCHASE, EXPENSE, FREIGHT, MAINTENANCE
  supplierId            String                     @db.Uuid
  purchaseOrderId       String?                    @db.Uuid
  goodsReceiptNoteId    String?                    @db.Uuid
  supplierInvoiceNumber String
  supplierInvoiceDate   DateTime
  billDate              DateTime                   @default(now())
  dueDate               DateTime
  fiscalYear            String
  supplierGstin         String?
  placeOfSupply         String                     @default("33")
  isInterState          Boolean                    @default(false)
  itcEligibility        String                     @default("INPUT_GOODS") // INPUT_GOODS, INPUT_SERVICES, CAPITAL_GOODS, INELIGIBLE_SEC_17_5
  taxableAmount         Decimal                    @default(0) @db.Decimal(15, 2)
  cgstAmount            Decimal                    @default(0) @db.Decimal(15, 2)
  sgstAmount            Decimal                    @default(0) @db.Decimal(15, 2)
  igstAmount            Decimal                    @default(0) @db.Decimal(15, 2)
  totalTaxAmount        Decimal                    @default(0) @db.Decimal(15, 2)
  tdsPercent            Decimal                    @default(0) @db.Decimal(5, 2)
  tdsAmount             Decimal                    @default(0) @db.Decimal(15, 2)
  grandTotal            Decimal                    @default(0) @db.Decimal(15, 2)
  paidAmount            Decimal                    @default(0) @db.Decimal(15, 2)
  outstandingAmount     Decimal                    @default(0) @db.Decimal(15, 2)
  paymentStatus         String                     @default("UNPAID") // UNPAID, PARTIAL, PAID
  status                String                     @default("POSTED") // DRAFT, APPROVED, POSTED, CANCELLED
  journalEntryId        String?                    @db.Uuid
  supportingDocUrl      String?
  remarks               String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  supplier              Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder         PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptNote      GoodsReceiptNote?          @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: SetNull)
  journalEntry          JournalEntry?              @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  items                 PurchaseBillItem[]
  paymentAllocations    SupplierPaymentAllocation[]

  @@unique([supplierId, supplierInvoiceNumber])
  @@index([billNumber])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptNoteId])
  @@index([status])
  @@index([paymentStatus])
}

model PurchaseBillItem {
  id                 String           @id @default(uuid()) @db.Uuid
  purchaseBillId     String           @db.Uuid
  materialVariantId  String?          @db.Uuid
  description        String
  hsnSacCode         String           @default("7308")
  quantity           Decimal          @default(1) @db.Decimal(12, 3)
  uom                String           @default("Nos.")
  unitRate           Decimal          @default(0) @db.Decimal(15, 2)
  taxableValue       Decimal          @default(0) @db.Decimal(15, 2)
  gstRatePercent     Decimal          @default(18) @db.Decimal(5, 2)
  cgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(15, 2)
  createdAt          DateTime         @default(now())

  purchaseBill       PurchaseBill     @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  materialVariant    MaterialVariant? @relation(fields: [materialVariantId], references: [id], onDelete: SetNull)

  @@index([purchaseBillId])
  @@index([materialVariantId])
}

// ------------------------------------------------------------------------------
// 30. Customer Receipts & Payment Allocations
// ------------------------------------------------------------------------------

model PaymentReceipt {
  id                   String              @id @default(uuid()) @db.Uuid
  receiptNumber        String              @unique // e.g. "AE/REC/2026-27/0001"
  customerId           String              @db.Uuid
  paymentDate          DateTime            @default(now())
  fiscalYear           String              // "2026-27"
  paymentMethod        String              // CASH, BANK_TRANSFER, NEFT_RTGS, UPI, CHEQUE
  depositAccountId     String              @db.Uuid // Bank or Cash ChartOfAccount
  amountReceived       Decimal             @db.Decimal(15, 2)
  allocatedAmount      Decimal             @default(0) @db.Decimal(15, 2)
  unallocatedAmount    Decimal             @default(0) @db.Decimal(15, 2) // Advance
  transactionReference String?             // UTR, Cheque No, UPI Ref
  bankName             String?
  chequeDate           DateTime?
  chequeStatus         String?             // PENDING_CLEARING, CLEARED, BOUNCED
  status               String              @default("POSTED") // DRAFT, POSTED, REVERSED
  journalEntryId       String?             @db.Uuid
  supportingDocUrl     String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  depositAccount       ChartOfAccount      @relation(fields: [depositAccountId], references: [id], onDelete: Restrict)
  journalEntry         JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  allocations          PaymentAllocation[]

  @@index([receiptNumber])
  @@index([customerId])
  @@index([paymentDate])
  @@index([status])
}

model PaymentAllocation {
  id               String         @id @default(uuid()) @db.Uuid
  receiptId        String         @db.Uuid
  invoiceId        String         @db.Uuid
  allocatedAmount  Decimal        @db.Decimal(15, 2)
  allocationDate   DateTime       @default(now())

  receipt          PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([invoiceId])
}

// ------------------------------------------------------------------------------
// 31. Supplier Payments & Bill Settlements
// ------------------------------------------------------------------------------

model SupplierPayment {
  id                   String                      @id @default(uuid()) @db.Uuid
  paymentNumber        String                      @unique // e.g. "AE/PAY/2026-27/0001"
  supplierId           String                      @db.Uuid
  paymentDate          DateTime                    @default(now())
  fiscalYear           String
  paymentMethod        String                      // BANK_TRANSFER, NEFT_RTGS, UPI, CASH, CHEQUE
  disbursingAccountId  String                      @db.Uuid
  amountPaid           Decimal                     @db.Decimal(15, 2)
  allocatedAmount      Decimal                     @default(0) @db.Decimal(15, 2)
  unallocatedAmount    Decimal                     @default(0) @db.Decimal(15, 2) // Supplier Advance
  transactionReference String?
  status               String                      @default("POSTED") // DRAFT, POSTED, REVERSED
  journalEntryId       String?                     @db.Uuid
  notes                String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  supplier             Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  disbursingAccount    ChartOfAccount              @relation(fields: [disbursingAccountId], references: [id], onDelete: Restrict)
  journalEntry         JournalEntry?               @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  allocations          SupplierPaymentAllocation[]

  @@index([paymentNumber])
  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
}

model SupplierPaymentAllocation {
  id                String          @id @default(uuid()) @db.Uuid
  supplierPaymentId String          @db.Uuid
  purchaseBillId    String          @db.Uuid
  allocatedAmount   Decimal         @db.Decimal(15, 2)
  allocationDate    DateTime        @default(now())

  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  purchaseBill      PurchaseBill    @relation(fields: [purchaseBillId], references: [id], onDelete: Restrict)

  @@index([supplierPaymentId])
  @@index([purchaseBillId])
}

// ------------------------------------------------------------------------------
// 32. Bank & Cash Transactions / Contra Vouchers
// ------------------------------------------------------------------------------

model BankTransaction {
  id                    String         @id @default(uuid()) @db.Uuid
  transactionNumber     String         @unique // e.g. "TXN-2026-0001"
  transactionType       String         // DEPOSIT, WITHDRAWAL, CONTRA_TRANSFER, BANK_CHARGE, INTEREST
  accountId             String         @db.Uuid
  counterpartyAccountId String?        @db.Uuid // Destination or Source for CONTRA transfers
  transactionDate       DateTime       @default(now())
  amount                Decimal        @db.Decimal(15, 2)
  referenceNumber       String?
  description           String
  isReconciled          Boolean        @default(false)
  reconciledDate        DateTime?
  statementReference    String?
  createdAt             DateTime       @default(now())

  account               ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([isReconciled])
}

// ------------------------------------------------------------------------------
// 33. Financial Year Closing & Period Locks
// ------------------------------------------------------------------------------

model FinancialYearClosing {
  id                          String    @id @default(uuid()) @db.Uuid
  fiscalYear                  String    @unique // e.g. "2025-26"
  startDate                   DateTime
  endDate                     DateTime
  isClosed                    Boolean   @default(false)
  closedAt                    DateTime?
  closedById                  String?   @db.Uuid
  retainedEarningsTransferred Decimal   @default(0) @db.Decimal(15, 2)
  closingJournalId            String?   @db.Uuid
  remarks                     String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

// ------------------------------------------------------------------------------
// 34. GST & HSN/SAC Master Data
// ------------------------------------------------------------------------------

model TaxRateMaster {
  id            String    @id @default(uuid()) @db.Uuid
  taxName       String    @unique // GST 18%, GST 12%, GST 5%, GST 28%, GST 0%
  ratePercent   Decimal   @db.Decimal(5, 2)
  cgstPercent   Decimal   @db.Decimal(5, 2)
  sgstPercent   Decimal   @db.Decimal(5, 2)
  igstPercent   Decimal   @db.Decimal(5, 2)
  isDefault     Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HsnSacMaster {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique // "9973", "7308", "9954"
  type           String   // HSN, SAC
  description    String
  defaultGstRate Decimal  @default(18) @db.Decimal(5, 2)
  category       String   // RENTAL, SCAFFOLDING_SUPPLY, TRANSPORT, LABOUR
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==============================================================================
// 35. Fleet Management (Vehicles, Drivers, Trips, Fuel, Maintenance, Expenses)
// Exclusively for AJAY ENTERPRISES Company-Owned Fleet
// ==============================================================================

model Vehicle {
  id                    String                      @id @default(uuid()) @db.Uuid
  vehicleNumber         String                      @unique // e.g. "TN-01-AB-1234"
  category              String                      @default("TRUCK") // TWO_WHEELER, CAR, VAN, PICKUP, TRUCK, TRACTOR, OTHER
  make                  String                      // e.g. "Tata", "Ashok Leyland", "Mahindra"
  model                 String                      // e.g. "407", "Dost", "Bolero"
  variant               String?
  fuelType              String                      @default("DIESEL") // PETROL, DIESEL, CNG, ELECTRIC, HYBRID
  chassisNumber         String?
  engineNumber          String?
  purchaseDate          DateTime?
  purchaseValue         Decimal?                    @db.Decimal(15, 2)
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceStartDate    DateTime?
  insuranceExpiryDate   DateTime?
  fitnessExpiryDate     DateTime?
  pollutionExpiryDate   DateTime?
  permitExpiryDate      DateTime?
  rcDocumentUrl         String?
  insuranceDocumentUrl  String?
  permitDocumentUrl     String?
  photoUrl              String?
  branchId              String?                     @db.Uuid
  defaultDriverId       String?                     @db.Uuid
  currentOdometer       Decimal                     @default(0) @db.Decimal(10, 2)
  status                String                      @default("ACTIVE") // ACTIVE, INACTIVE, UNDER_MAINTENANCE, SOLD, RETIRED
  notes                 String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  branch                Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  defaultDriver         Driver?                     @relation("DefaultDriver", fields: [defaultDriverId], references: [id], onDelete: SetNull)
  driverAssignments     DriverVehicleAssignment[]
  trips                 VehicleTrip[]
  fuelLogs              VehicleFuelLog[]
  maintenanceRecords    VehicleMaintenanceRecord[]
  expenses              VehicleExpense[]
  directSiteTransfers   DirectSiteTransferNote[]

  @@index([status])
  @@index([branchId])
}

model Driver {
  id                 String                    @id @default(uuid()) @db.Uuid
  driverCode         String                    @unique // e.g. "DRV-0001"
  name               String
  mobileNumber       String
  address            String?
  emergencyContact   String?
  licenseNumber      String                    @unique
  licenseClass       String?                   // LMV, HMV, TRANS
  licenseExpiryDate  DateTime
  joiningDate        DateTime                  @default(now())
  assignedVehicleId  String?                   @db.Uuid
  salaryType         String                    @default("MONTHLY") // MONTHLY, DAILY, TRIP_BASED
  salaryAmount       Decimal                   @default(0) @db.Decimal(15, 2)
  status             String                    @default("ACTIVE") // ACTIVE, INACTIVE
  licenseDocumentUrl String?
  idDocumentUrl      String?
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  defaultForVehicles Vehicle[]                 @relation("DefaultDriver")
  vehicleAssignments DriverVehicleAssignment[]
  trips              VehicleTrip[]
  fuelLogs           VehicleFuelLog[]
  directSiteTransfers DirectSiteTransferNote[]

  @@index([status])
  @@index([mobileNumber])
}

model DriverVehicleAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  driverId     String    @db.Uuid
  vehicleId    String    @db.Uuid
  assignedFrom DateTime  @default(now())
  assignedTo   DateTime?
  reason       String?
  remarks      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driver       Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([vehicleId])
}

model VehicleTrip {
  id                 String                    @id @default(uuid()) @db.Uuid
  tripNumber         String                    @unique // e.g. "AE/TRIP/2026-27/0001"
  vehicleId          String                    @db.Uuid
  driverId           String?                   @db.Uuid
  originWarehouseId  String?                   @db.Uuid
  originAddress      String?
  destinationSiteId  String?                   @db.Uuid
  destinationAddress String?
  tripDate           DateTime                  @default(now())
  departureTime      DateTime?
  arrivalTime        DateTime?
  startOdometer      Decimal                   @db.Decimal(10, 2)
  endOdometer        Decimal?                  @db.Decimal(10, 2)
  distanceKm         Decimal?                  @db.Decimal(10, 2)
  tripPurpose        String                    @default("DELIVERY") // DELIVERY, RETURN_PICKUP, SITE_TRANSFER, MAINTENANCE, OTHER
  status             String                    @default("PLANNED") // PLANNED, IN_TRANSIT, COMPLETED, CANCELLED
  fuelUsedLitres     Decimal?                  @db.Decimal(8, 2)
  tripExpenses       Decimal                   @default(0) @db.Decimal(15, 2)
  remarks            String?
  createdById        String?                   @db.Uuid
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  vehicle            Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver             Driver?                   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  originWarehouse    Warehouse?                @relation("TripOriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: SetNull)
  destinationSite    CustomerSite?             @relation("TripDestinationSite", fields: [destinationSiteId], references: [id], onDelete: SetNull)
  deliveryNotes      VehicleTripDeliveryNote[]
  expenses           VehicleExpense[]
  directSiteTransfers DirectSiteTransferNote[]

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([tripDate])
}

model VehicleTripDeliveryNote {
  id             String       @id @default(uuid()) @db.Uuid
  tripId         String       @db.Uuid
  deliveryNoteId String       @db.Uuid
  createdAt      DateTime     @default(now())

  trip           VehicleTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Restrict)

  @@unique([tripId, deliveryNoteId])
}

model VehicleFuelLog {
  id                 String        @id @default(uuid()) @db.Uuid
  logNumber          String        @unique // e.g. "FUEL-2026-0001"
  vehicleId          String        @db.Uuid
  driverId           String?       @db.Uuid
  fuelDate           DateTime      @default(now())
  fuelType           String        @default("DIESEL") // PETROL, DIESEL, CNG, ELECTRIC
  fuelStation        String?
  quantityLitres     Decimal       @db.Decimal(10, 2) // Litres or kWh
  pricePerUnit       Decimal       @db.Decimal(10, 2)
  totalCost          Decimal       @db.Decimal(15, 2)
  odometerReading    Decimal       @db.Decimal(10, 2)
  isFullTank         Boolean       @default(true)
  distanceSinceLast  Decimal?      @db.Decimal(10, 2)
  mileageKmPerLitre  Decimal?      @db.Decimal(8, 2)
  costPerKm          Decimal?      @db.Decimal(10, 2)
  receiptDocumentUrl String?
  remarks            String?
  journalEntryId     String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver             Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([fuelDate])
}

model VehicleMaintenanceRecord {
  id                  String        @id @default(uuid()) @db.Uuid
  recordNumber        String        @unique // e.g. "VMR-2026-0001"
  vehicleId           String        @db.Uuid
  serviceCategory     String        @default("REGULAR_SERVICE") // REGULAR_SERVICE, ENGINE_REPAIR, TYRES, BATTERY, BRAKE_SYSTEM, ELECTRICAL, BODYWORK, INSURANCE_REPAIR, OTHER
  serviceDate         DateTime      @default(now())
  odometerReading     Decimal       @db.Decimal(10, 2)
  serviceProvider     String?
  descriptionOfWork   String
  partsCost           Decimal       @default(0) @db.Decimal(15, 2)
  labourCost          Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(15, 2)
  totalCost           Decimal       @default(0) @db.Decimal(15, 2)
  invoiceDocumentUrl  String?
  nextServiceDate     DateTime?
  nextServiceOdometer Decimal?      @db.Decimal(10, 2)
  remarks             String?
  status              String        @default("COMPLETED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  journalEntryId      String?       @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  journalEntry        JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([serviceDate])
}

model VehicleExpense {
  id                 String        @id @default(uuid()) @db.Uuid
  expenseNumber      String        @unique // e.g. "AE/VEXP/2026-27/0001"
  vehicleId          String        @db.Uuid
  tripId             String?       @db.Uuid
  expenseCategory    String        @default("OTHER") // FUEL, REPAIR_MAINTENANCE, INSURANCE, ROAD_TAX_PERMIT, TOLL, PARKING, DRIVER_ALLOWANCE, OTHER
  expenseDate        DateTime      @default(now())
  amount             Decimal       @db.Decimal(15, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal       @db.Decimal(15, 2)
  paymentMode        String        @default("CASH") // CASH, BANK_TRANSFER, UPI, CHEQUE
  paymentReference   String?
  paidFromAccountId  String?       @db.Uuid
  supplierId         String?       @db.Uuid
  itcEligibility     String        @default("INELIGIBLE_SEC_17_5") // Fleet expenses are typically Sec 17(5) unless transport business
  receiptDocumentUrl String?
  description        String
  status             String        @default("POSTED") // DRAFT, APPROVED, POSTED, CANCELLED
  journalEntryId     String?       @db.Uuid
  postedById         String?       @db.Uuid
  postedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trip               VehicleTrip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([expenseDate])
  @@index([status])
}

// ==============================================================================
// 36. Labour & Workforce Management
// ==============================================================================

model LabourWorker {
  id                   String                 @id @default(uuid()) @db.Uuid
  workerCode           String                 @unique // e.g. "WRK-0001"
  name                 String
  mobileNumber         String
  address              String?
  emergencyContact     String?
  category             String                 @default("GENERAL_LABOUR") // LOADING_UNLOADING, WAREHOUSE_LABOUR, DRIVERS, MATERIAL_HANDLING, REPAIR_MAINTENANCE, GENERAL_LABOUR, SKILLED, SUPERVISOR, OTHER
  skillTrade           String?                // Welder, Fitter, Loader, Driver, Mason
  joiningDate          DateTime               @default(now())
  wageType             String                 @default("DAILY") // DAILY, MONTHLY
  dailyWage            Decimal                @default(0) @db.Decimal(15, 2)
  monthlySalary        Decimal                @default(0) @db.Decimal(15, 2)
  paymentFrequency     String                 @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  assignedSupervisorId String?                @db.Uuid
  branchId             String?                @db.Uuid
  idDocumentUrl        String?
  status               String                 @default("ACTIVE") // ACTIVE, INACTIVE
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  branch               Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendances          LabourAttendance[]
  wageSettlements      LabourWageSettlement[]
  advances             LabourAdvance[]
  payments             LabourPayment[]
  assignedRepairJobs   MaterialRepairJob[]    @relation("AssignedTechnician")
  openingBalanceItems  OpeningBalanceItem[]

  @@index([status])
  @@index([branchId])
}

model LabourAttendance {
  id                 String        @id @default(uuid()) @db.Uuid
  workerId           String        @db.Uuid
  attendanceDate     DateTime      @db.Date
  branchId           String?       @db.Uuid
  customerSiteId     String?       @db.Uuid
  status             String        @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, PAID_LEAVE, UNPAID_LEAVE, HOLIDAY
  checkInTime        DateTime?
  checkOutTime       DateTime?
  overtimeHours      Decimal       @default(0) @db.Decimal(5, 2)
  supervisorRemarks  String?
  recordedById       String?       @db.Uuid
  approvedById       String?       @db.Uuid
  isApproved         Boolean       @default(false)
  approvedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  worker             LabourWorker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerSite       CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)

  @@unique([workerId, attendanceDate])
  @@index([attendanceDate])
  @@index([status])
}

model LabourAdvance {
  id                String        @id @default(uuid()) @db.Uuid
  advanceNumber     String        @unique // e.g. "AE/LADV/2026-27/0001"
  workerId          String        @db.Uuid
  advanceDate       DateTime      @default(now())
  amount            Decimal       @db.Decimal(15, 2)
  paymentMode       String        @default("CASH") // CASH, BANK_TRANSFER, UPI
  paymentReference  String?
  paidFromAccountId String?       @db.Uuid
  purpose           String?
  status            String        @default("APPROVED") // PENDING, APPROVED, RECOVERED, PARTIALLY_RECOVERED, CANCELLED
  recoveredAmount   Decimal       @default(0) @db.Decimal(15, 2)
  outstandingAmount Decimal       @db.Decimal(15, 2)
  approvedById      String?       @db.Uuid
  journalEntryId    String?       @db.Uuid
  remarks           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  worker            LabourWorker  @relation(fields: [workerId], references: [id], onDelete: Restrict)
  journalEntry      JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([advanceDate])
  @@index([status])
}

model LabourWageSettlement {
  id               String          @id @default(uuid()) @db.Uuid
  settlementNumber String          @unique // e.g. "AE/LWAGE/2026-27/0001"
  workerId         String          @db.Uuid
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  daysPresent      Decimal         @default(0) @db.Decimal(5, 2)
  halfDays         Decimal         @default(0) @db.Decimal(5, 2)
  daysLeave        Decimal         @default(0) @db.Decimal(5, 2)
  overtimeHours    Decimal         @default(0) @db.Decimal(6, 2)
  baseWageAmount   Decimal         @default(0) @db.Decimal(15, 2)
  overtimeAmount   Decimal         @default(0) @db.Decimal(15, 2)
  bonusAmount      Decimal         @default(0) @db.Decimal(15, 2)
  grossAmount      Decimal         @default(0) @db.Decimal(15, 2)
  advanceDeduction Decimal         @default(0) @db.Decimal(15, 2)
  otherDeductions  Decimal         @default(0) @db.Decimal(15, 2)
  netPayable       Decimal         @default(0) @db.Decimal(15, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(15, 2)
  status           String          @default("DRAFT") // DRAFT, APPROVED, PAID, CANCELLED
  approvedById     String?         @db.Uuid
  approvedAt       DateTime?
  journalEntryId   String?         @db.Uuid
  remarks          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  worker           LabourWorker    @relation(fields: [workerId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  payments         LabourPayment[]

  @@index([workerId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model LabourPayment {
  id                 String                @id @default(uuid()) @db.Uuid
  paymentNumber      String                @unique // e.g. "AE/LPAY/2026-27/0001"
  workerId           String                @db.Uuid
  wageSettlementId   String?               @db.Uuid
  paymentDate        DateTime              @default(now())
  amount             Decimal               @db.Decimal(15, 2)
  paymentMode        String                @default("CASH") // CASH, BANK_TRANSFER, UPI
  paymentReference   String?
  paidFromAccountId  String?               @db.Uuid
  receiptDocumentUrl String?
  journalEntryId     String?               @db.Uuid
  status             String                @default("POSTED") // POSTED, CANCELLED
  remarks            String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  worker             LabourWorker          @relation(fields: [workerId], references: [id], onDelete: Restrict)
  wageSettlement     LabourWageSettlement? @relation(fields: [wageSettlementId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry?         @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([paymentDate])
}

// ==============================================================================
// 37. Centering Material Repair & Maintenance Management
// Exclusively for AJAY ENTERPRISES Scaffolding & Centering Material Reconditioning
// ==============================================================================

model MaterialRepairJob {
  id                   String              @id @default(uuid()) @db.Uuid
  jobCode              String              @unique // e.g. "AE/REP/2026-27/0001"
  warehouseId          String              @db.Uuid
  materialVariantId    String              @db.Uuid
  ownershipType        String              @default("OWNED") // OWNED, HIRED_IN
  mrnId                String?             @db.Uuid
  rentalBatchId        String?             @db.Uuid
  directSiteTransferId String?             @db.Uuid
  totalQuantity        Decimal             @db.Decimal(12, 3)
  repairedQuantity     Decimal             @default(0) @db.Decimal(12, 3)
  scrappedQuantity     Decimal             @default(0) @db.Decimal(12, 3)
  remainingQuantity    Decimal             @db.Decimal(12, 3)
  damageDescription    String
  damagePhotoUrl       String?
  priority             String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedTechnicianId String?             @db.Uuid
  startDate            DateTime?
  targetDate           DateTime?
  completedDate        DateTime?
  partsCost            Decimal             @default(0) @db.Decimal(15, 2)
  labourCost           Decimal             @default(0) @db.Decimal(15, 2)
  externalVendorCost   Decimal             @default(0) @db.Decimal(15, 2)
  totalCost            Decimal             @default(0) @db.Decimal(15, 2)
  repairVendor         String?
  status               String              @default("REPORTED") 
  // REPORTED, UNDER_INSPECTION, APPROVED_FOR_REPAIR, IN_REPAIR, AWAITING_PARTS, REPAIR_COMPLETED, QUALITY_CHECK, RETURNED_TO_AVAILABLE_STOCK, WRITTEN_OFF
  qualityApprovedById  String?             @db.Uuid
  qualityApprovedAt    DateTime?
  journalEntryId       String?             @db.Uuid
  remarks              String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  materialVariant      MaterialVariant     @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  materialReturnNote   MaterialReturnNote? @relation(fields: [mrnId], references: [id], onDelete: SetNull)
  rentalBatch          RentalBatch?        @relation(fields: [rentalBatchId], references: [id], onDelete: SetNull)
  directSiteTransfer   DirectSiteTransferNote? @relation(fields: [directSiteTransferId], references: [id], onDelete: SetNull)
  assignedTechnician   LabourWorker?       @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  journalEntry         JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  logs                 MaterialRepairLog[]

  @@index([warehouseId])
  @@index([materialVariantId])
  @@index([directSiteTransferId])
  @@index([status])
  @@index([ownershipType])
}

model MaterialRepairLog {
  id             String            @id @default(uuid()) @db.Uuid
  repairJobId    String            @db.Uuid
  logDate        DateTime          @default(now())
  action         String            // INSPECTED, STARTED_WORK, PARTS_REPLACED, WELDING_DONE, QUALITY_CHECKED, RELEASED_TO_STOCK, SCRAPPED
  notes          String
  technicianName String?
  partsUsed      String?
  cost           Decimal           @default(0) @db.Decimal(15, 2)
  createdAt      DateTime          @default(now())

  repairJob      MaterialRepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([repairJobId])
}

// ============================================================================
// PHASE 8: PRODUCTION CUTOVER, OPENING BALANCES, PILOT & GO-LIVE READINESS
// ============================================================================

model OpeningStockBatch {
  id                  String             @id @default(uuid()) @db.Uuid
  batchNumber         String             @unique // e.g. "OSB-2026-0001"
  title               String             @default("Initial Cutover Stock Entry")
  cutoverDate         DateTime           @default(now())
  status              String             @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, POSTED, REJECTED
  notes               String?
  totalItems          Int                @default(0)
  totalOwnedQty       Decimal            @default(0) @db.Decimal(12, 3)
  totalHiredQty       Decimal            @default(0) @db.Decimal(12, 3)
  totalOwnedValuation Decimal            @default(0) @db.Decimal(15, 2)
  preparedById        String?            @db.Uuid
  approvedById        String?            @db.Uuid
  approvedAt          DateTime?
  postedById          String?            @db.Uuid
  postedAt            DateTime?
  supportingDocUrl    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items               OpeningStockItem[]

  @@index([batchNumber])
  @@index([status])
  @@index([cutoverDate])
}

model OpeningStockItem {
  id                  String            @id @default(uuid()) @db.Uuid
  batchId             String            @db.Uuid
  materialVariantId   String            @db.Uuid
  ownershipType       String            @default("OWNED") // OWNED, HIRED_IN
  locationType        String            @default("WAREHOUSE") // WAREHOUSE, CUSTOMER_SITE
  warehouseId         String?           @db.Uuid
  customerId          String?           @db.Uuid
  customerSiteId      String?           @db.Uuid
  quantity            Decimal           @db.Decimal(12, 3)
  uom                 String            @default("Nos.")
  condition           String            @default("GOOD") // GOOD, DAMAGED
  unitCost            Decimal?          @db.Decimal(15, 2)
  totalValuation      Decimal?          @db.Decimal(15, 2)
  dailyRentalRate     Decimal?          @db.Decimal(15, 2)
  inventoryMovementId String?           @db.Uuid
  rentalBatchId       String?           @db.Uuid
  status              String            @default("DRAFT") // DRAFT, POSTED, REJECTED
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  batch               OpeningStockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  materialVariant     MaterialVariant   @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  warehouse           Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerSite        CustomerSite?     @relation(fields: [customerSiteId], references: [id], onDelete: SetNull)

  @@unique([batchId, materialVariantId, ownershipType, locationType, warehouseId, customerSiteId])
  @@index([batchId])
  @@index([materialVariantId])
  @@index([ownershipType])
  @@index([locationType])
  @@index([warehouseId])
  @@index([customerSiteId])
}

model OpeningBalanceBatch {
  id                  String               @id @default(uuid()) @db.Uuid
  batchNumber         String               @unique // e.g. "OBB-2026-0001"
  fiscalYear          String               // e.g. "2026-27"
  asOfDate            DateTime             @default(now())
  status              String               @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, POSTED, REJECTED
  totalDebit          Decimal              @default(0) @db.Decimal(15, 2)
  totalCredit         Decimal              @default(0) @db.Decimal(15, 2)
  difference          Decimal              @default(0) @db.Decimal(15, 2)
  isBalanced          Boolean              @default(false)
  journalEntryId      String?              @db.Uuid
  preparedById        String?              @db.Uuid
  approvedById        String?              @db.Uuid
  approvedAt          DateTime?
  postedById          String?              @db.Uuid
  postedAt            DateTime?
  notes               String?
  supportingDocUrl    String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  items               OpeningBalanceItem[]

  @@index([batchNumber])
  @@index([fiscalYear])
  @@index([status])
  @@index([journalEntryId])
}

model OpeningBalanceItem {
  id              String              @id @default(uuid()) @db.Uuid
  batchId         String              @db.Uuid
  accountId       String              @db.Uuid
  accountCode     String
  accountName     String
  partyType       String?             // CUSTOMER, SUPPLIER, WORKER, BANK, NONE
  customerId      String?             @db.Uuid
  supplierId      String?             @db.Uuid
  workerId        String?             @db.Uuid
  partyName       String?
  referenceNumber String?
  description     String?
  debitAmount     Decimal             @default(0) @db.Decimal(15, 2)
  creditAmount    Decimal             @default(0) @db.Decimal(15, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  batch           OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  account         ChartOfAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier        Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  worker          LabourWorker?       @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([accountId])
  @@index([customerId])
  @@index([supplierId])
  @@index([workerId])
}

model CutoverMilestone {
  id                 String    @id @default(uuid()) @db.Uuid
  category           String    // COMPANY_CONFIG, MASTER_DATA, OPENING_STOCK, OPENING_FINANCES, RECONCILIATION, PILOT, GO_LIVE
  code               String    @unique // e.g. "CO_COMPANY_LEGAL", "CO_TAX_CONFIG", etc.
  title              String
  description        String?
  status             String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, PENDING_APPROVAL, COMPLETED, BLOCKED
  isMandatory        Boolean   @default(true)
  hasDiscrepancies   Boolean   @default(false)
  discrepancyDetails String?
  completedById      String?   @db.Uuid
  completedAt        DateTime?
  approvedById       String?   @db.Uuid
  approvedAt         DateTime?
  notes              String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([code])
  @@index([status])
}

model PilotProgram {
  id                 String    @id @default(uuid()) @db.Uuid
  pilotNumber        String    @unique // e.g. "PILOT-2026-0001"
  name               String
  description        String?
  startDate          DateTime  @default(now())
  targetEndDate      DateTime
  actualEndDate      DateTime?
  status             String    @default("DRAFT") // DRAFT, ACTIVE, UNDER_REVIEW, COMPLETED, CANCELLED
  approvedById       String?   @db.Uuid
  approvedAt         DateTime?
  selectedWarehouses String?   // JSON string of warehouse IDs
  selectedCustomers  String?   // JSON string of customer IDs
  selectedSites      String?   // JSON string of site IDs
  metrics            String?   // JSON summary of operational metrics
  exceptionsLog      String?   // JSON array of logged exceptions
  completionReview   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([pilotNumber])
  @@index([status])
  @@index([startDate])
}

model StaffTrainingModule {
  id                String    @id @default(uuid()) @db.Uuid
  role              String    // ADMINISTRATOR, ACCOUNTANT, WAREHOUSE_MANAGER, WAREHOUSE_STAFF, DELIVERY_MANAGER, DELIVERY_PERSONNEL, LABOUR_SUPERVISOR, AUDITOR
  moduleCode        String    @unique // e.g. "TRN_ADMIN_01", "TRN_WH_01", etc.
  title             String
  description       String?
  workflowChecklist String    // JSON string of checklist items
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  verifiedById      String?   @db.Uuid
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([role])
  @@index([moduleCode])
  @@index([isCompleted])
}
