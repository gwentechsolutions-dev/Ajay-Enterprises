# Node Environment & URLs
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE MANAGED BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xewkpocahshdckvrzpmt.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# DATABASE CONNECTION STRATEGY (PRISMA ORM & SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Session Mode Pooler (Port 5432) - Required for Prisma ORM (persistent prepared statements)
DATABASE_URL="postgresql://postgres.xewkpocahshdckvrzpmt:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Direct / Session Connection (Port 5432) - For Prisma Migrations
DIRECT_URL="postgresql://postgres.xewkpocahshdckvrzpmt:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# PRIVATE STORAGE CONFIGURATION (SUPABASE STORAGE)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=supabase
STORAGE_BUCKET=inventra-private-documents
STORAGE_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (E-Way Bill & WhatsApp)
# ------------------------------------------------------------------------------
# E-WAY BILL PROVIDER
EWAYBILL_ACTIVE_PROVIDER=WHITEBOOKS

