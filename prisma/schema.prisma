// ==============================================================================
// INVENTRA - Prisma Database Schema
// Operating Business: AJAY ENTERPRISES | Product: INVENTRA
// Managed Backend: Supabase PostgreSQL (with PostGIS Extension)
// ==============================================================================

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ------------------------------------------------------------------------------
// 1. Identity & Access Management (IAM)
// Integrated with Supabase Auth (auth.users)
// ------------------------------------------------------------------------------

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  supabaseId           String?                @unique @db.Uuid // UUID linking to Supabase auth.users(id)
  userCode             String                 @unique // e.g. "USR-0001"
  name                 String
  email                String                 @unique
  username             String?                @unique
  mobile               String
  role                 String                 @default("READ_ONLY") // OWNER, ADMINISTRATOR, ACCOUNTANT, WAREHOUSE_MANAGER, WAREHOUSE_STAFF, DELIVERY_MANAGER, DELIVERY_PERSONNEL, LABOUR_SUPERVISOR, AUDITOR
  scope                String                 @default("ALL_BUSINESS") // ALL_BUSINESS, ASSIGNED_WAREHOUSE, ASSIGNED_SITE, ASSIGNED_DELIVERY
  branchId             String?                @db.Uuid
  warehouseId          String?                @db.Uuid
  isActive             Boolean                @default(true)
  lastLogin            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  branch               Branch?                @relation(fields: [branchId], references: [id])
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id])
  auditEvents          AuditEvent[]
  rateChanges          MaterialRateHistory[]  @relation("RateChanges")
  responsibleMovements InventoryMovement[]    @relation("ResponsibleMovements")
  approvedMovements    InventoryMovement[]    @relation("ApprovedMovements")
  conductedAudits      StockAudit[]           @relation("ConductedAudits")
  approvedAudits       StockAudit[]           @relation("ApprovedAudits")

  @@index([role])
  @@index([email])
  @@index([userCode])
  @@index([supabaseId])
}

model RolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  role      String   // OWNER, ADMINISTRATOR, ACCOUNTANT, WAREHOUSE_MANAGER, WAREHOUSE_STAFF, DELIVERY_MANAGER, DELIVERY_PERSONNEL, LABOUR_SUPERVISOR, AUDITOR
  module    String   // company, branches, warehouses, users, roles, document_settings, audit_logs, customers, suppliers, inventory, movement, billing, accounting, fleet, labour
  action    String   // view, create, edit, approve, post, cancel, export, delete
  isAllowed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module, action])
  @@index([role])
}

// ------------------------------------------------------------------------------
// 2. Company Profile & Settings (AJAY ENTERPRISES)
// ------------------------------------------------------------------------------

model CompanyProfile {
  id                   String            @id @default(uuid()) @db.Uuid
  legalName            String            @default("AJAY ENTERPRISES")
  tradeName            String            @default("AJAY ENTERPRISES")
  entityType           String            @default("PROPRIETORSHIP") // PROPRIETORSHIP, PARTNERSHIP, PVT_LTD, LTD, LLP
  establishmentDate    DateTime?
  businessCategory     String?           @default("Construction Centering Material Rental & Formwork Equipment")
  description          String?
  website              String?
  primaryMobile        String            @default("")
  alternateMobile      String?
  whatsappNumber       String            @default("")
  officialEmail        String            @default("")
  alternateEmail       String?
  contactPerson        String            @default("")
  telephone            String?
  pan                  String?
  gstin                String?
  gstLegalName         String?
  gstTradeName         String?
  gstType              String?           @default("REGULAR") // REGULAR, COMPOSITION, UNREGISTERED
  gstState             String?
  gstStateCode         String?
  gstRegistrationDate  DateTime?
  logoAssetUrl         String?
  isOnboardingComplete Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  addresses            CompanyAddress[]
  bankAccounts         BankAccount[]
  documents            CompanyDocument[]
  signatories          SignatoryAsset[]
}

model CompanyAddress {
  id                      String         @id @default(uuid()) @db.Uuid
  companyId               String         @db.Uuid
  addressType             String         // REGISTERED, HEAD_OFFICE, BILLING, CORRESPONDENCE, YARD
  addressLine1            String
  addressLine2            String?
  areaLocality            String?
  city                    String
  district                String
  state                   String
  stateCode               String
  pinCode                 String
  country                 String         @default("India")
  isDefaultBilling        Boolean        @default(false)
  isDefaultCorrespondence Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  company                 CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model BankAccount {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @db.Uuid
  bankName          String
  accountHolderName String
  accountNumber     String
  ifscCode          String
  branchName        String?
  accountType       String         @default("CURRENT") // CURRENT, SAVINGS, OVERDRAFT
  upiId             String?
  qrAssetUrl        String?
  isPrimary         Boolean        @default(false)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyDocument {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @db.Uuid
  documentType String         // GST_CERTIFICATE, PAN_CARD, BUSINESS_REGISTRATION, MSME, OTHER
  title        String
  fileName     String
  fileMime     String
  fileSize     Int
  storagePath  String
  expiryDate   DateTime?
  uploadedBy   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SignatoryAsset {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @db.Uuid
  name               String
  designation        String
  signatureAssetUrl  String
  stampAssetUrl      String?
  authorizationLimit Decimal?       @db.Decimal(15, 2)
  isDefault          Boolean        @default(false)
  isActive           Boolean        @default(true)
  validFrom          DateTime       @default(now())
  validUntil         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company            CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 3. Branches & Warehouses (AJAY ENTERPRISES Yards)
// ------------------------------------------------------------------------------

model Branch {
  id            String      @id @default(uuid()) @db.Uuid
  branchCode    String      @unique // e.g. "BR-01"
  name          String
  branchType    String      @default("MAIN_OFFICE") // MAIN_OFFICE, REGIONAL_OFFICE, YARD_BRANCH
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pinCode       String
  contactPerson String
  mobile        String
  email         String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  warehouses    Warehouse[]
  users         User[]
  purchaseOrders PurchaseOrder[]

  @@index([branchCode])
}

model Warehouse {
  id                   String              @id @default(uuid()) @db.Uuid
  warehouseCode        String              @unique // e.g. "WH-01"
  name                 String
  branchId             String              @db.Uuid
  warehouseType        String              @default("MAIN_YARD") // MAIN_YARD, SECONDARY_YARD, SATELLITE_YARD
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  pinCode              String
  contactPerson        String
  mobile               String
  gpsLatitude          Decimal?            @db.Decimal(10, 7)
  gpsLongitude         Decimal?            @db.Decimal(10, 7)
  storageCapacitySqFt  Decimal?            @db.Decimal(12, 2)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  users                User[]
  sourceMovements      InventoryMovement[] @relation("SourceMovements")
  destinationMovements InventoryMovement[] @relation("DestinationMovements")
  stockBalances        StockBalance[]
  stockAudits          StockAudit[]
  deliveryWarehousePOs PurchaseOrder[]     @relation("DeliveryWarehouse")
  receivingGRNs        GoodsReceiptNote[]
  returnWarehouses     PurchaseReturn[]
  sourceDeliveryNotes  DeliveryNote[]      @relation("SourceWarehouseDN")
  receivingReturnNotes MaterialReturnNote[] @relation("ReceivingWarehouseMRN")
  sourceTransferNotes  StockTransferNote[] @relation("SourceWarehouseSTN")
  destinationTransferNotes StockTransferNote[] @relation("DestinationWarehouseSTN")
  hiringDeliveryWarehouses HiringDeliveryNote[]
  hiringReturnWarehouses   HiringReturnNote[]

  @@index([warehouseCode])
  @@index([branchId])
}

// ------------------------------------------------------------------------------
// 4. Material Master Management (Hierarchical Catalogue)
// ------------------------------------------------------------------------------

model MaterialCategory {
  id           String         @id @default(uuid()) @db.Uuid
  categoryCode String         @unique // e.g. "CAT-01"
  name         String         // e.g. "Centering Materials", "Scaffolding"
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  types        MaterialType[]

  @@index([categoryCode])
}

model MaterialType {
  id          String            @id @default(uuid()) @db.Uuid
  categoryId  String            @db.Uuid
  typeCode    String            @unique // e.g. "TYP-01"
  name        String            // e.g. "Props", "Folding Sheets", "Column Boxes"
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  category    MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    MaterialVariant[]

  @@index([typeCode])
  @@index([categoryId])
}

model MaterialVariant {
  id                       String                @id @default(uuid()) @db.Uuid
  materialCode             String                @unique // e.g. "MAT-0001"
  materialTypeId           String                @db.Uuid
  name                     String                // e.g. "PROPS 7-12 ft"
  size                     String                // e.g. "7-12 ft", "3 x 2 ft"
  description              String?
  uom                      String                @default("Nos.") // Nos., Set, Bundle, Meter
  defaultRentalRate        Decimal               @db.Decimal(15, 2) // Per day
  purchaseCost             Decimal?              @db.Decimal(15, 2)
  replacementValue         Decimal?              @db.Decimal(15, 2)
  minimumStock             Decimal               @default(0) @db.Decimal(12, 3)
  preferredSupplierId      String?               @db.Uuid
  ownershipClassification  String                @default("OWNED") // OWNED, HIRED_IN
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  materialType             MaterialType          @relation(fields: [materialTypeId], references: [id], onDelete: Restrict)
  preferredSupplier        Supplier?             @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  rateHistory              MaterialRateHistory[]
  movements                InventoryMovement[]
  stockBalances            StockBalance[]
  auditItems               StockAuditItem[]
  poItems                  PurchaseOrderItem[]
  grnItems                 GoodsReceiptNoteItem[]
  purchaseReturnItems      PurchaseReturnItem[]
  deliveryNoteItems        DeliveryNoteItem[]
  returnNoteItems          MaterialReturnNoteItem[]
  transferNoteItems        StockTransferNoteItem[]
  hiringDeliveryItems      HiringDeliveryNoteItem[]
  hiringReturnItems        HiringReturnNoteItem[]

  @@index([materialCode])
  @@index([materialTypeId])
  @@index([ownershipClassification])
}

model MaterialRateHistory {
  id                String          @id @default(uuid()) @db.Uuid
  materialVariantId String          @db.Uuid
  rentalRate        Decimal         @db.Decimal(15, 2)
  previousRate      Decimal?        @db.Decimal(15, 2)
  effectiveFrom     DateTime        @default(now())
  effectiveTo       DateTime?
  reason            String?
  changedById       String?         @db.Uuid
  createdAt         DateTime        @default(now())

  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Cascade)
  changedBy         User?           @relation("RateChanges", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([materialVariantId])
  @@index([effectiveFrom])
}

// ------------------------------------------------------------------------------
// 5. Customer & Construction Site Master
// ------------------------------------------------------------------------------

model Customer {
  id                   String             @id @default(uuid()) @db.Uuid
  customerCode         String             @unique // e.g. "CUST-0001"
  name                 String
  customerType         String             @default("COMPANY") // INDIVIDUAL, COMPANY, CONTRACTOR
  legalBusinessName    String?
  primaryMobile        String
  alternateMobile      String?
  whatsappNumber       String?
  email                String?
  pan                  String?
  gstStatus            String             @default("UNREGISTERED") // REGISTERED, UNREGISTERED, COMPOSITION
  gstin                String?
  billingAddress       String
  communicationAddress String?
  state                String
  stateCode            String
  pinCode              String?
  businessType         String?            // COMMERCIAL, RESIDENTIAL, INFRASTRUCTURE, INDUSTRIAL
  creditLimit          Decimal?           @db.Decimal(15, 2)
  paymentTermsDays     Int                @default(30)
  openingBalance       Decimal            @default(0) @db.Decimal(15, 2)
  isActive             Boolean            @default(true)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  sites                CustomerSite[]
  contacts             ContactPerson[]
  documents            CustomerDocument[]
  movements            InventoryMovement[]
  deliveryNotes        DeliveryNote[]
  returnNotes          MaterialReturnNote[]

  @@index([customerCode])
  @@index([primaryMobile])
  @@index([pan])
  @@index([gstin])
}

model CustomerSite {
  id                   String              @id @default(uuid()) @db.Uuid
  siteCode             String              @unique // e.g. "SITE-0001"
  customerId           String              @db.Uuid
  siteName             String
  fullAddress          String
  state                String
  stateCode            String
  district             String
  city                 String
  pinCode              String
  gpsLatitude          Decimal?            @db.Decimal(10, 7)
  gpsLongitude         Decimal?            @db.Decimal(10, 7)
  siteOwnerName        String?
  siteOwnerContact     String?
  siteInCharge         String?
  siteContactDetails   String?
  projectType          String?             // RESIDENTIAL, COMMERCIAL, INDUSTRIAL, INFRASTRUCTURE
  deliveryInstructions String?
  openingDate          DateTime            @default(now())
  expectedClosingDate  DateTime?
  actualClosingDate    DateTime?
  status               String              @default("ACTIVE") // ACTIVE, INACTIVE, CLOSED
  internalRemarks      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts             ContactPerson[]
  documents            CustomerDocument[]
  sourceMovements      InventoryMovement[] @relation("SiteSourceMovements")
  destinationMovements InventoryMovement[] @relation("SiteDestinationMovements")
  stockBalances        StockBalance[]
  deliveryNotes        DeliveryNote[]
  returnNotes          MaterialReturnNote[]

  @@index([siteCode])
  @@index([customerId])
  @@index([status])
}

model ContactPerson {
  id                         String        @id @default(uuid()) @db.Uuid
  customerId                 String?       @db.Uuid
  siteId                     String?       @db.Uuid
  name                       String
  mobile                     String
  alternateMobile            String?
  email                      String?
  designation                String        // Site Supervisor, Project Manager, Accountant, etc.
  contactType                String        @default("SITE_INCHARGE") // PRIMARY, BILLING, SITE_INCHARGE, RECEIVER, OWNER
  isPrimary                  Boolean       @default(false)
  isActive                   Boolean       @default(true)
  canReceiveDeliveryNotes    Boolean       @default(true)
  canAcknowledgeDeliveries   Boolean       @default(true)
  canReceiveReturnNotes      Boolean       @default(true)
  canReceiveInvoices         Boolean       @default(false)
  canReceivePaymentReminders Boolean       @default(false)
  canReceiveWhatsApp         Boolean       @default(true)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  customer                   Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site                       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deliveryNotes              DeliveryNote[]

  @@index([customerId])
  @@index([siteId])
  @@index([mobile])
}

model CustomerDocument {
  id           String        @id @default(uuid()) @db.Uuid
  customerId   String        @db.Uuid
  siteId       String?       @db.Uuid
  documentType String        // PAN_CARD, GST_CERTIFICATE, COMPANY_REGISTRATION, SITE_PHOTO, SITE_AGREEMENT, ID_PROOF, OTHER
  title        String
  fileName     String
  fileMime     String
  fileSize     Int
  storagePath  String
  uploadedBy   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site         CustomerSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([siteId])
}

// ------------------------------------------------------------------------------
// 6. Supplier Master
// ------------------------------------------------------------------------------

model Supplier {
  id               String             @id @default(uuid()) @db.Uuid
  supplierCode     String             @unique // e.g. "SUP-0001"
  name             String
  contactPerson    String
  primaryMobile    String
  alternateMobile  String?
  email            String?
  gstStatus        String             @default("UNREGISTERED") // REGISTERED, UNREGISTERED, COMPOSITION
  gstin            String?
  pan              String?
  billingAddress   String
  state            String
  stateCode        String
  pinCode          String
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  supplierType     String             @default("MANUFACTURER") // MANUFACTURER, TRADER, HIRE_VENDOR, SERVICE_PROVIDER
  openingBalance   Decimal            @default(0) @db.Decimal(15, 2)
  creditTermsDays  Int                @default(30)
  isActive         Boolean            @default(true)
  internalRemarks  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  documents            SupplierDocument[]
  materialVariants     MaterialVariant[]
  movements            InventoryMovement[]
  purchaseOrders       PurchaseOrder[]
  grns                 GoodsReceiptNote[]
  purchaseReturns      PurchaseReturn[]
  hiringDeliveryNotes  HiringDeliveryNote[]
  hiringReturnNotes    HiringReturnNote[]

  @@index([supplierCode])
  @@index([primaryMobile])
  @@index([gstin])
}

model SupplierDocument {
  id           String   @id @default(uuid()) @db.Uuid
  supplierId   String   @db.Uuid
  documentType String   // GST_CERTIFICATE, PAN_CARD, MSME_REGISTRATION, BANK_PROOF, AGREEMENT, OTHER
  title        String
  fileName     String
  fileMime     String
  fileSize     Int
  storagePath  String
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ------------------------------------------------------------------------------
// 7. Inventory Movement Ledger & Stock Balances
// Mathematical derivation from immutable append-only movements
// ------------------------------------------------------------------------------

model InventoryMovement {
  id                      String          @id @default(uuid()) @db.Uuid
  movementNumber          String          @unique // e.g. "MV-2026-0001"
  materialVariantId       String          @db.Uuid
  quantity                Decimal         @db.Decimal(12, 3)
  uom                     String          @default("Nos.")
  ownershipType           String          @default("OWNED") // OWNED, HIRED_IN
  movementType            String          // OPENING_STOCK, STOCK_RECEIPT, DELIVERY_TO_CUSTOMER, CUSTOMER_RETURN, INTERNAL_TRANSFER, SITE_TO_SITE_TRANSFER, DAMAGE, DAMAGE_RECOVERY, MISSING, FOUND_STOCK, MAINTENANCE_OUT, MAINTENANCE_RETURN, SCRAP, STOCK_ADJUSTMENT, REVERSAL
  movementDate            DateTime        @default(now())
  sourceLocationType      String          // WAREHOUSE, CUSTOMER_SITE, IN_TRANSIT, DAMAGE_YARD, MAINTENANCE, MISSING, SUPPLIER, NONE
  sourceWarehouseId       String?         @db.Uuid
  sourceSiteId            String?         @db.Uuid
  destinationLocationType String          // WAREHOUSE, CUSTOMER_SITE, IN_TRANSIT, DAMAGE_YARD, MAINTENANCE, MISSING, SCRAP, NONE
  destinationWarehouseId  String?         @db.Uuid
  destinationSiteId       String?         @db.Uuid
  customerId              String?         @db.Uuid
  supplierId              String?         @db.Uuid
  referenceDocumentType   String?         // OPENING_STOCK, DELIVERY_NOTE, RETURN_NOTE, TRANSFER_NOTE, AUDIT_ADJUSTMENT, MANUAL_ADJUSTMENT
  referenceDocumentId     String?
  batchOrLotNumber        String?
  condition               String          @default("GOOD") // GOOD, FAIR, DAMAGED, REPAIRABLE, SCRAP
  unitCost                Decimal?        @db.Decimal(15, 2)
  replacementValue        Decimal?        @db.Decimal(15, 2)
  responsibleUserId       String?         @db.Uuid
  approvedById            String?         @db.Uuid
  approvedAt              DateTime?
  status                  String          @default("POSTED") // DRAFT, POSTED, REVERSED
  reversedMovementId      String?         @db.Uuid
  notes                   String?
  createdAt               DateTime        @default(now())
  postedAt                DateTime?

  materialVariant         MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  sourceWarehouse         Warehouse?      @relation("SourceMovements", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse    Warehouse?      @relation("DestinationMovements", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  sourceSite              CustomerSite?   @relation("SiteSourceMovements", fields: [sourceSiteId], references: [id], onDelete: Restrict)
  destinationSite         CustomerSite?   @relation("SiteDestinationMovements", fields: [destinationSiteId], references: [id], onDelete: Restrict)
  customer                Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier                Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  responsibleUser         User?           @relation("ResponsibleMovements", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  approvedBy              User?           @relation("ApprovedMovements", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([movementNumber])
  @@index([materialVariantId])
  @@index([movementType])
  @@index([ownershipType])
  @@index([movementDate])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([sourceSiteId])
  @@index([destinationSiteId])
  @@index([customerId])
  @@index([status])
}

model StockBalance {
  id                String          @id @default(uuid()) @db.Uuid
  warehouseId       String?         @db.Uuid
  siteId            String?         @db.Uuid
  materialVariantId String          @db.Uuid
  ownershipType     String          @default("OWNED") // OWNED, HIRED_IN
  locationType      String          // WAREHOUSE, CUSTOMER_SITE, IN_TRANSIT, DAMAGED, MAINTENANCE, MISSING
  availableQty      Decimal         @default(0) @db.Decimal(12, 3)
  damagedQty        Decimal         @default(0) @db.Decimal(12, 3)
  maintenanceQty    Decimal         @default(0) @db.Decimal(12, 3)
  missingQty        Decimal         @default(0) @db.Decimal(12, 3)
  totalQty          Decimal         @default(0) @db.Decimal(12, 3)
  lastMovementAt    DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  site              CustomerSite?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, siteId, materialVariantId, ownershipType, locationType])
  @@index([warehouseId])
  @@index([siteId])
  @@index([materialVariantId])
  @@index([ownershipType])
  @@index([locationType])
}

// ------------------------------------------------------------------------------
// 8. Physical Stock Verification & Reconciliation
// ------------------------------------------------------------------------------

model StockAudit {
  id            String           @id @default(uuid()) @db.Uuid
  auditNumber   String           @unique // e.g. "AUD-2026-0001"
  warehouseId   String           @db.Uuid
  title         String
  auditDate     DateTime         @default(now())
  status        String           @default("IN_PROGRESS") // DRAFT, IN_PROGRESS, PENDING_APPROVAL, APPROVED, REJECTED, COMPLETED
  conductedById String           @db.Uuid
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?
  remarks       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  conductedBy   User             @relation("ConductedAudits", fields: [conductedById], references: [id], onDelete: Restrict)
  approvedBy    User?            @relation("ApprovedAudits", fields: [approvedById], references: [id], onDelete: SetNull)
  items         StockAuditItem[]

  @@index([auditNumber])
  @@index([warehouseId])
  @@index([status])
}

model StockAuditItem {
  id                   String          @id @default(uuid()) @db.Uuid
  stockAuditId         String          @db.Uuid
  materialVariantId    String          @db.Uuid
  ownershipType        String          @default("OWNED") // OWNED, HIRED_IN
  expectedQty          Decimal         @db.Decimal(12, 3)
  physicalQty          Decimal         @db.Decimal(12, 3)
  differenceQty        Decimal         @db.Decimal(12, 3) // physicalQty - expectedQty
  condition            String          @default("GOOD") // GOOD, FAIR, DAMAGED, SCRAP
  adjustmentStatus     String          @default("PENDING") // PENDING, ADJUSTED, IGNORED
  adjustmentMovementId String?         @db.Uuid
  remarks              String?
  photoUrl             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  stockAudit           StockAudit      @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
  materialVariant      MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([stockAuditId])
  @@index([materialVariantId])
  @@index([adjustmentStatus])
}

// ------------------------------------------------------------------------------
// 9. Document Series & Numbering Sequences
// ------------------------------------------------------------------------------

model DocumentSeries {
  id             String   @id @default(uuid()) @db.Uuid
  documentType   String   // QUOTATION, PROFORMA, PO, PURCHASE_INV, SALES_INV, HIRING_INV, SERVICE_INV, DN, MRN, STN, HDN, HRN, CREDIT_NOTE, DEBIT_NOTE, RECEIPT, PAYMENT_VOUCHER, JOURNAL, MATERIAL, CUSTOMER, SITE, SUPPLIER, MOVEMENT, AUDIT
  prefix         String   // e.g. "AE/DN/", "AE/INV/"
  fiscalYear     String   // e.g. "2026-27"
  currentCounter Int      @default(0)
  padding        Int      @default(4) // 0001
  suffix         String?  @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([documentType, fiscalYear])
  @@index([documentType])
  @@index([fiscalYear])
}

model FinancialYear {
  id        String   @id @default(uuid()) @db.Uuid
  yearCode  String   @unique // e.g. "2026-27"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yearCode])
}

// ------------------------------------------------------------------------------
// 10. Append-Only Audit Logging Foundation
// ------------------------------------------------------------------------------

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  userName      String?
  userRole      String?
  ipAddress     String?
  userAgent     String?
  action        String   // LOGIN, LOGOUT, FAILED_LOGIN, CREATE, UPDATE, DELETE, DEACTIVATE, PASSWORD_CHANGE, EXPORT, UPLOAD, POST, APPROVE, REVERSE
  module        String   // AUTH, USERS, ROLES, COMPANY, BRANCHES, WAREHOUSES, SERIES, AUDIT, CUSTOMERS, SUPPLIERS, INVENTORY, MOVEMENTS, STOCK_AUDIT
  entityType    String   // User, CompanyProfile, BankAccount, Branch, Warehouse, DocumentSeries, Customer, CustomerSite, ContactPerson, Supplier, MaterialCategory, MaterialType, MaterialVariant, InventoryMovement, StockAudit
  entityId      String?
  beforeState   String?  // JSON stringified state
  afterState    String?  // JSON stringified state
  correlationId String?
  notes         String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 11. Purchase Management (PO, GRN, Purchase Return)
// ------------------------------------------------------------------------------

model PurchaseOrder {
  id                   String              @id @default(uuid()) @db.Uuid
  poNumber             String              @unique // e.g. "PO-2026-0001"
  supplierId           String              @db.Uuid
  branchId             String              @db.Uuid
  deliveryWarehouseId  String              @db.Uuid
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               String              @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  subtotal             Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(15, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(15, 2)
  grandTotal           Decimal             @default(0) @db.Decimal(15, 2)
  notes                String?
  termsAndConditions   String?
  createdById          String?             @db.Uuid
  approvedById         String?             @db.Uuid
  approvedAt           DateTime?
  cancelledById        String?             @db.Uuid
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  deliveryWarehouse    Warehouse           @relation("DeliveryWarehouse", fields: [deliveryWarehouseId], references: [id], onDelete: Restrict)
  items                PurchaseOrderItem[]
  grns                 GoodsReceiptNote[]

  @@index([poNumber])
  @@index([supplierId])
  @@index([branchId])
  @@index([deliveryWarehouseId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseOrderId   String          @db.Uuid
  materialVariantId String          @db.Uuid
  quantity          Decimal         @db.Decimal(12, 3)
  unitRate          Decimal         @db.Decimal(15, 2)
  discountPercent   Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(15, 2)
  taxPercent        Decimal         @default(18) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount       Decimal         @db.Decimal(15, 2)
  receivedQty       Decimal         @default(0) @db.Decimal(12, 3)

  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([materialVariantId])
}

model GoodsReceiptNote {
  id                    String                 @id @default(uuid()) @db.Uuid
  grnNumber             String                 @unique // e.g. "GRN-2026-0001"
  purchaseOrderId       String?                @db.Uuid
  supplierId            String                 @db.Uuid
  receivingWarehouseId  String                 @db.Uuid
  receiptDate           DateTime               @default(now())
  supplierInvoiceNumber String?
  supplierInvoiceDate   DateTime?
  status                String                 @default("DRAFT") // DRAFT, POSTED, CANCELLED
  remarks               String?
  postedById            String?                @db.Uuid
  postedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  purchaseOrder         PurchaseOrder?         @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier              Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivingWarehouse    Warehouse              @relation(fields: [receivingWarehouseId], references: [id], onDelete: Restrict)
  items                 GoodsReceiptNoteItem[]
  purchaseReturns       PurchaseReturn[]

  @@index([grnNumber])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([receivingWarehouseId])
  @@index([status])
  @@index([receiptDate])
}

model GoodsReceiptNoteItem {
  id                String          @id @default(uuid()) @db.Uuid
  grnId             String          @db.Uuid
  materialVariantId String          @db.Uuid
  poItemId          String?         @db.Uuid
  orderedQty        Decimal         @default(0) @db.Decimal(12, 3)
  receivedQty       Decimal         @db.Decimal(12, 3)
  acceptedQty       Decimal         @db.Decimal(12, 3)
  rejectedQty       Decimal         @default(0) @db.Decimal(12, 3)
  damagedQty        Decimal         @default(0) @db.Decimal(12, 3)
  unitCost          Decimal?        @db.Decimal(15, 2)
  condition         String          @default("GOOD")
  remarks           String?

  grn               GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant  @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([grnId])
  @@index([materialVariantId])
}

model PurchaseReturn {
  id           String               @id @default(uuid()) @db.Uuid
  prNumber     String               @unique // e.g. "PR-2026-0001"
  supplierId   String               @db.Uuid
  warehouseId  String               @db.Uuid
  grnId        String?              @db.Uuid
  returnDate   DateTime             @default(now())
  reason       String
  status       String               @default("DRAFT") // DRAFT, POSTED, CANCELLED
  postedById   String?              @db.Uuid
  postedAt     DateTime?
  remarks      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  grn          GoodsReceiptNote?    @relation(fields: [grnId], references: [id], onDelete: SetNull)
  items        PurchaseReturnItem[]

  @@index([prNumber])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseReturnItem {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseReturnId  String          @db.Uuid
  materialVariantId String          @db.Uuid
  quantity          Decimal         @db.Decimal(12, 3)
  unitCost          Decimal?        @db.Decimal(15, 2)
  reason            String?

  purchaseReturn    PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([materialVariantId])
}

// ------------------------------------------------------------------------------
// 12. Material Delivery Note (DN)
// ------------------------------------------------------------------------------

model DeliveryNote {
  id                    String             @id @default(uuid()) @db.Uuid
  dnNumber              String             @unique // e.g. "DN-2026-0001"
  customerId            String             @db.Uuid
  customerSiteId        String             @db.Uuid
  sourceWarehouseId     String             @db.Uuid
  deliveryDate          DateTime           @default(now())
  status                String             @default("DRAFT") // DRAFT, APPROVED, DISPATCHED, DELIVERED, CANCELLED
  driverName            String?
  driverPhone           String?
  vehicleNumber         String?
  transportMode         String?            @default("COMPANY_VEHICLE")
  eWayBillNumber        String?
  contactPersonId       String?            @db.Uuid
  receiverName          String?
  receiverPhone         String?
  receiverDesignation   String?
  receiverSignatureUrl  String?
  gpsLatitude           Decimal?           @db.Decimal(10, 7)
  gpsLongitude          Decimal?           @db.Decimal(10, 7)
  gpsAccuracy           Decimal?           @db.Decimal(8, 2)
  photoUrl              String?
  missingEvidenceReason String?
  approvedById          String?            @db.Uuid
  approvedAt            DateTime?
  dispatchedById        String?            @db.Uuid
  dispatchedAt          DateTime?
  deliveredById         String?            @db.Uuid
  deliveredAt           DateTime?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  customer              Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite          CustomerSite       @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  sourceWarehouse       Warehouse          @relation("SourceWarehouseDN", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  contactPerson         ContactPerson?     @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)
  items                 DeliveryNoteItem[]
  evidences             MovementEvidence[]
  eWayBills             EWayBill[]
  returnNotes           MaterialReturnNote[]

  @@index([dnNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([sourceWarehouseId])
  @@index([status])
  @@index([deliveryDate])
}

model DeliveryNoteItem {
  id                String          @id @default(uuid()) @db.Uuid
  deliveryNoteId    String          @db.Uuid
  materialVariantId String          @db.Uuid
  quantity          Decimal         @db.Decimal(12, 3)
  ownershipType     String          @default("OWNED") // OWNED, HIRED_IN
  dailyRate         Decimal?        @db.Decimal(15, 2)
  condition         String          @default("GOOD")
  remarks           String?

  deliveryNote      DeliveryNote    @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@index([materialVariantId])
  @@index([ownershipType])
}

// ------------------------------------------------------------------------------
// 13. Material Return Note (MRN)
// ------------------------------------------------------------------------------

model MaterialReturnNote {
  id                      String                   @id @default(uuid()) @db.Uuid
  mrnNumber               String                   @unique // e.g. "MRN-2026-0001"
  customerId              String                   @db.Uuid
  customerSiteId          String                   @db.Uuid
  receivingWarehouseId    String                   @db.Uuid
  referenceDeliveryNoteId String?                  @db.Uuid
  returnDate              DateTime                 @default(now())
  status                  String                   @default("DRAFT") // DRAFT, POSTED, CANCELLED
  driverName              String?
  driverPhone             String?
  vehicleNumber           String?
  receiverName            String?
  receiverPhone           String?
  receiverSignatureUrl    String?
  gpsLatitude             Decimal?                 @db.Decimal(10, 7)
  gpsLongitude            Decimal?                 @db.Decimal(10, 7)
  photoUrl                String?
  missingEvidenceReason   String?
  postedById              String?                  @db.Uuid
  postedAt                DateTime?
  remarks                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  customer                Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite            CustomerSite             @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  receivingWarehouse      Warehouse                @relation("ReceivingWarehouseMRN", fields: [receivingWarehouseId], references: [id], onDelete: Restrict)
  referenceDeliveryNote   DeliveryNote?            @relation(fields: [referenceDeliveryNoteId], references: [id], onDelete: SetNull)
  items                   MaterialReturnNoteItem[]
  evidences               MovementEvidence[]

  @@index([mrnNumber])
  @@index([customerId])
  @@index([customerSiteId])
  @@index([receivingWarehouseId])
  @@index([status])
  @@index([returnDate])
}

model MaterialReturnNoteItem {
  id                   String             @id @default(uuid()) @db.Uuid
  mrnId                String             @db.Uuid
  materialVariantId    String             @db.Uuid
  ownershipType        String             @default("OWNED") // OWNED, HIRED_IN
  returnedQty          Decimal            @db.Decimal(12, 3)
  acceptedQty          Decimal            @db.Decimal(12, 3)
  damagedQty           Decimal            @default(0) @db.Decimal(12, 3)
  missingQty           Decimal            @default(0) @db.Decimal(12, 3)
  condition            String             @default("GOOD")
  remarks              String?

  materialReturnNote   MaterialReturnNote @relation(fields: [mrnId], references: [id], onDelete: Cascade)
  materialVariant      MaterialVariant    @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([mrnId])
  @@index([materialVariantId])
  @@index([ownershipType])
}

// ------------------------------------------------------------------------------
// 14. Stock Transfer Note (STN)
// ------------------------------------------------------------------------------

model StockTransferNote {
  id                     String                  @id @default(uuid()) @db.Uuid
  stnNumber              String                  @unique // e.g. "STN-2026-0001"
  sourceWarehouseId      String                  @db.Uuid
  destinationWarehouseId String                  @db.Uuid
  transferDate           DateTime                @default(now())
  status                 String                  @default("DRAFT") // DRAFT, APPROVED, DISPATCHED, IN_TRANSIT, RECEIVED, CANCELLED
  vehicleNumber          String?
  driverName             String?
  driverPhone            String?
  eWayBillNumber         String?
  dispatchedById         String?                 @db.Uuid
  dispatchedAt           DateTime?
  receivedById           String?                 @db.Uuid
  receivedAt             DateTime?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  sourceWarehouse        Warehouse               @relation("SourceWarehouseSTN", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse               @relation("DestinationWarehouseSTN", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items                  StockTransferNoteItem[]
  evidences              MovementEvidence[]
  eWayBills              EWayBill[]

  @@index([stnNumber])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([transferDate])
}

model StockTransferNoteItem {
  id                  String            @id @default(uuid()) @db.Uuid
  stnId               String            @db.Uuid
  materialVariantId   String            @db.Uuid
  ownershipType       String            @default("OWNED") // OWNED, HIRED_IN
  dispatchedQty       Decimal           @db.Decimal(12, 3)
  receivedQty         Decimal           @default(0) @db.Decimal(12, 3)
  shortageQty         Decimal           @default(0) @db.Decimal(12, 3)
  damagedQty          Decimal           @default(0) @db.Decimal(12, 3)
  condition           String            @default("GOOD")
  remarks             String?

  stockTransferNote   StockTransferNote @relation(fields: [stnId], references: [id], onDelete: Cascade)
  materialVariant     MaterialVariant   @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([stnId])
  @@index([materialVariantId])
  @@index([ownershipType])
}

// ------------------------------------------------------------------------------
// 15. Hired-In Material Operations (HDN / HRN)
// ------------------------------------------------------------------------------

model HiringDeliveryNote {
  id                    String                   @id @default(uuid()) @db.Uuid
  hdnNumber             String                   @unique // e.g. "HDN-2026-0001"
  supplierId            String                   @db.Uuid
  receivingWarehouseId  String                   @db.Uuid
  receiptDate           DateTime                 @default(now())
  supplierReference     String?
  effectiveDate         DateTime                 @default(now())
  status                String                   @default("DRAFT") // DRAFT, POSTED, CANCELLED
  postedById            String?                  @db.Uuid
  postedAt              DateTime?
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  supplier              Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivingWarehouse    Warehouse                @relation(fields: [receivingWarehouseId], references: [id], onDelete: Restrict)
  items                 HiringDeliveryNoteItem[]
  returnNotes           HiringReturnNote[]

  @@index([hdnNumber])
  @@index([supplierId])
  @@index([receivingWarehouseId])
  @@index([status])
}

model HiringDeliveryNoteItem {
  id                 String             @id @default(uuid()) @db.Uuid
  hdnId              String             @db.Uuid
  materialVariantId  String             @db.Uuid
  quantity           Decimal            @db.Decimal(12, 3)
  dailyHiringRate    Decimal            @db.Decimal(15, 2)
  condition          String             @default("GOOD")
  remarks            String?

  hiringDeliveryNote HiringDeliveryNote @relation(fields: [hdnId], references: [id], onDelete: Cascade)
  materialVariant    MaterialVariant    @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([hdnId])
  @@index([materialVariantId])
}

model HiringReturnNote {
  id                 String                 @id @default(uuid()) @db.Uuid
  hrnNumber          String                 @unique // e.g. "HRN-2026-0001"
  supplierId         String                 @db.Uuid
  sourceWarehouseId  String                 @db.Uuid
  referenceHdnId     String?                @db.Uuid
  returnDate         DateTime               @default(now())
  status             String                 @default("DRAFT") // DRAFT, POSTED, CANCELLED
  postedById         String?                @db.Uuid
  postedAt           DateTime?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  supplier           Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceWarehouse    Warehouse              @relation(fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  referenceHdn       HiringDeliveryNote?    @relation(fields: [referenceHdnId], references: [id], onDelete: SetNull)
  items              HiringReturnNoteItem[]

  @@index([hrnNumber])
  @@index([supplierId])
  @@index([sourceWarehouseId])
  @@index([status])
}

model HiringReturnNoteItem {
  id                String           @id @default(uuid()) @db.Uuid
  hrnId             String           @db.Uuid
  materialVariantId String           @db.Uuid
  quantity          Decimal          @db.Decimal(12, 3)
  condition         String           @default("GOOD")
  remarks           String?

  hiringReturnNote  HiringReturnNote @relation(fields: [hrnId], references: [id], onDelete: Cascade)
  materialVariant   MaterialVariant  @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([hrnId])
  @@index([materialVariantId])
}

// ------------------------------------------------------------------------------
// 16. Evidence & Acknowledgement
// ------------------------------------------------------------------------------

model MovementEvidence {
  id                    String              @id @default(uuid()) @db.Uuid
  documentType          String              // DELIVERY_NOTE, RETURN_NOTE, TRANSFER_NOTE, GRN
  documentId            String              @db.Uuid
  deliveryNoteId        String?             @db.Uuid
  returnNoteId          String?             @db.Uuid
  transferNoteId        String?             @db.Uuid
  photoUrl              String
  storagePath           String?
  fileChecksum          String?
  gpsLatitude           Decimal?            @db.Decimal(10, 7)
  gpsLongitude          Decimal?            @db.Decimal(10, 7)
  gpsAccuracy           Decimal?            @db.Decimal(8, 2)
  capturedAt            DateTime            @default(now())
  capturedById          String?             @db.Uuid
  receiverName          String?
  receiverPhone         String?
  receiverDesignation   String?
  receiverSignatureUrl  String?
  missingEvidenceReason String?
  createdAt             DateTime            @default(now())

  deliveryNote          DeliveryNote?       @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  returnNote            MaterialReturnNote? @relation(fields: [returnNoteId], references: [id], onDelete: Cascade)
  transferNote          StockTransferNote?  @relation(fields: [transferNoteId], references: [id], onDelete: Cascade)

  @@index([documentType, documentId])
  @@index([deliveryNoteId])
  @@index([returnNoteId])
  @@index([transferNoteId])
}

// ------------------------------------------------------------------------------
// 17. E-Way Bill Integration (FYN Gateway)
// ------------------------------------------------------------------------------

model EWayBill {
  id              String             @id @default(uuid()) @db.Uuid
  ewbNumber       String             @unique // Official 12-digit E-Way Bill number
  documentType    String             // DELIVERY_NOTE, TRANSFER_NOTE
  documentId      String             @db.Uuid
  deliveryNoteId  String?            @db.Uuid
  transferNoteId  String?            @db.Uuid
  generatedAt     DateTime           @default(now())
  validUntil      DateTime?
  vehicleNumber   String?
  fromPincode     String?
  toPincode       String?
  distanceKm      Int?
  status          String             @default("ACTIVE") // ACTIVE, CANCELLED, EXPIRED
  fynReferenceId  String?
  cancelReason    String?
  cancelledAt     DateTime?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  deliveryNote    DeliveryNote?      @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  transferNote    StockTransferNote? @relation(fields: [transferNoteId], references: [id], onDelete: Cascade)

  @@index([ewbNumber])
  @@index([documentType, documentId])
  @@index([deliveryNoteId])
  @@index([transferNoteId])
  @@index([status])
}
