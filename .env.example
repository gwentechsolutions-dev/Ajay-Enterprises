# Direct / Session Connection (Port 5432) - For Prisma Migrations
DIRECT_URL="postgresql://postgres.xewkpocahshdckvrzpmt:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# PRIVATE STORAGE CONFIGURATION (SUPABASE STORAGE)
