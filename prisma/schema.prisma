model StockTransferNoteItem {
  id                  String            @id @default(uuid()) @db.Uuid
  stnId               String            @db.Uuid
  materialVariantId   String            @db.Uuid
  ownershipType       String            @default("OWNED") // OWNED, HIRED_IN
  dispatchedQty       Decimal           @db.Decimal(12, 3)
  receivedQty         Decimal           @default(0) @db.Decimal(12, 3)
  shortageQty         Decimal           @default(0) @db.Decimal(12, 3)
  damagedQty          Decimal           @default(0) @db.Decimal(12, 3)
  condition           String            @default("GOOD")
  remarks             String?

  stockTransferNote   StockTransferNote @relation(fields: [stnId], references: [id], onDelete: Cascade)
  materialVariant     MaterialVariant   @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)

  @@index([stnId])
  @@index([materialVariantId])
  @@index([ownershipType])
}

// ------------------------------------------------------------------------------
// 15. Hired-In Material Operations (HDN / HRN)
